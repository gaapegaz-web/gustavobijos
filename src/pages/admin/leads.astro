---
/**
 * Lista de todos os leads do site (qualquer página ou formulário), com busca, filtros e UTMs de origem.
 * Filtros na URL (?q=&pagina=&origem=&criado=&situacao=&ordem=&p=), para dar para salvar ou mandar o link.
 */
import Admin from '~/layouts/Admin.astro';
import { db } from '~/lib/db';
import { num, dt, nomePagina, fone, NOME_DISP } from '~/lib/painel';

export const prerender = false;

const d = db();
const u = Astro.url.searchParams;
const f = {
  q: (u.get('q') || '').trim(),
  pagina: u.get('pagina') || '',
  origem: u.get('origem') || '',
  criado: ['1', '7', '30'].includes(u.get('criado') || '') ? u.get('criado')! : '',
  situacao: ['grupo', 'sem-grupo', 'comprou', 'repetido'].includes(u.get('situacao') || '') ? u.get('situacao')! : '',
  ordem: ['antigos', 'nome', 'tempo'].includes(u.get('ordem') || '') ? u.get('ordem')! : '',
};
const POR_PAGINA = 50;
const pag = Math.max(1, Number(u.get('p')) || 1);

const where: string[] = []; const params: unknown[] = [];
if (f.q) {
  const digitos = f.q.replace(/\D/g, '');
  where.push(`(l.nome LIKE ?${digitos.length >= 4 ? ' OR l.whatsapp LIKE ?' : ''})`);
  params.push(`%${f.q}%`, ...(digitos.length >= 4 ? [`%${digitos}%`] : []));
}
if (f.pagina) { where.push('l.pagina = ?'); params.push(f.pagina); }
if (f.origem) { if (f.origem === '(direto)') where.push('l.utm_source IS NULL'); else { where.push('l.utm_source = ?'); params.push(f.origem); } }
if (f.criado) { where.push(`l.created_at >= datetime('now', ?)`); params.push(`-${f.criado} days`); }
if (f.situacao === 'grupo') where.push('s.clicou_grupo = 1');
if (f.situacao === 'sem-grupo') where.push('coalesce(s.clicou_grupo, 0) = 0');
if (f.situacao === 'comprou') where.push('l.comprou = 1');
if (f.situacao === 'repetido') where.push('l.envios > 1');
const W = where.length ? `WHERE ${where.join(' AND ')}` : '';
const ORDEM = { '': 'l.id DESC', antigos: 'l.id ASC', nome: 'l.nome COLLATE NOCASE ASC', tempo: 's.tempo_ativo_s DESC' }[f.ordem];

const FROM = `FROM leads l LEFT JOIN sessoes s ON s.id = l.sessao_id ${W}`;
const total = (d.prepare(`SELECT count(*) n ${FROM}`).get(...params) as any).n as number;
const paginas = Math.max(1, Math.ceil(total / POR_PAGINA));
const lista = d.prepare(`SELECT l.id, l.nome, l.whatsapp, l.pagina, l.utm_source, l.utm_medium, l.utm_campaign, l.utm_content, l.utm_term, l.created_at, l.envios, l.meta_lead,
  s.dispositivo ${FROM} ORDER BY ${ORDEM} LIMIT ? OFFSET ?`).all(...params, POR_PAGINA, (Math.min(pag, paginas) - 1) * POR_PAGINA) as any[];

const geral = d.prepare(`SELECT count(*) n, coalesce(sum(created_at >= datetime('now','-1 day')),0) hoje FROM leads`).get() as any;
const opPaginas = (d.prepare(`SELECT pagina p, count(*) n FROM leads WHERE pagina IS NOT NULL GROUP BY p ORDER BY n DESC`).all() as any[]);
const opOrigens = (d.prepare(`SELECT coalesce(utm_source,'(direto)') o, count(*) n FROM leads GROUP BY o ORDER BY n DESC`).all() as any[]);
const filtrando = !!(f.q || f.pagina || f.origem || f.criado || f.situacao);
const link = (extra: Record<string, string | number>) => `?${new URLSearchParams(Object.entries({ ...f, ...extra }).filter(([, v]) => v !== '' && v !== 1).map(([k, v]) => [k, String(v)]))}`;
const wa = (n: string) => `https://wa.me/${n.replace(/\D/g, '')}`;
---
<Admin titulo="Leads" ativo="leads" sub={`Todos os cadastros do site: ${num(geral.n)} no total, ${num(geral.hoje)} nas últimas 24 h. Busque, filtre e exporte.`}>
  <a slot="acoes" class="btn sec" href="/admin/leads.csv"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>Exportar CSV</a>

  <form class="filtros" method="get" id="filtros">
    <label class="busca"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input type="search" name="q" value={f.q} placeholder="Nome ou WhatsApp" aria-label="Buscar por nome ou WhatsApp" /></label>
    <div class="filtros__sel">
      <label class="campo"><span>Página</span><select name="pagina"><option value="">Todas</option>{opPaginas.map((o) => <option value={o.p} selected={o.p === f.pagina}>{nomePagina(o.p)} ({o.n})</option>)}</select></label>
      <label class="campo"><span>Origem</span><select name="origem"><option value="">Todas</option>{opOrigens.map((o) => <option value={o.o} selected={o.o === f.origem}>{o.o} ({o.n})</option>)}</select></label>
      <label class="campo"><span>Criado</span><select name="criado"><option value="">Qualquer data</option><option value="1" selected={f.criado === '1'}>Últimas 24 h</option><option value="7" selected={f.criado === '7'}>Últimos 7 dias</option><option value="30" selected={f.criado === '30'}>Últimos 30 dias</option></select></label>
      <label class="campo"><span>Situação</span><select name="situacao"><option value="">Todos</option><option value="grupo" selected={f.situacao === 'grupo'}>Entraram no grupo</option><option value="sem-grupo" selected={f.situacao === 'sem-grupo'}>Não clicaram no grupo</option><option value="comprou" selected={f.situacao === 'comprou'}>Compraram</option><option value="repetido" selected={f.situacao === 'repetido'}>Cadastraram mais de uma vez</option></select></label>
      <label class="campo"><span>Ordem</span><select name="ordem"><option value="">Mais recentes</option><option value="antigos" selected={f.ordem === 'antigos'}>Mais antigos</option><option value="nome" selected={f.ordem === 'nome'}>Nome (A–Z)</option><option value="tempo" selected={f.ordem === 'tempo'}>Mais tempo no site</option></select></label>
      <noscript><button class="btn sec">Filtrar</button></noscript>
    </div>
  </form>

  <div class="card p0">
    {lista.length === 0 ? (
      <div class="vazio"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <div>{filtrando
          ? <><b>Nenhum lead com esses filtros.</b><a href="/admin/leads">Limpar os filtros</a></>
          : <><b>Nenhum lead ainda.</b>Os leads chegam sozinhos pelos formulários do site, de qualquer página.</>}</div>
      </div>
    ) : (
      <>
        <div class="lista__topo"><span>{filtrando ? `${num(total)} ${total === 1 ? 'lead encontrado' : 'leads encontrados'}` : `${num(total)} leads`}</span>{filtrando && <a href="/admin/leads">Limpar filtros</a>}</div>
        <div class="tbl"><table class="lista"><colgroup><col style="width:19%" /><col style="width:5%" /><col style="width:6%" /><col class="opc" style="width:8%" /><col style="width:10%" /><col style="width:13%" /><col style="width:12%" /><col style="width:12%" /><col style="width:13%" /></colgroup><thead><tr><th>Lead</th><th>Página</th><th>Origem</th><th class="opc">Aparelho</th><th>UTM Medium</th><th>UTM Campaign</th><th>UTM Content</th><th>UTM Term</th><th>Quando</th></tr></thead><tbody>
          {lista.map((l) => <tr>
            <td><div class="lead"><span class="lead__av" aria-hidden="true">{(l.nome || '?').trim().charAt(0).toUpperCase()}</span><div><b>{l.nome}</b>{l.envios > 1 && <span class="tag warn" title={l.meta_lead === 0 ? 'cadastrou de novo do mesmo aparelho' : 'cadastrou mais de uma vez'} style="margin-left:6px">{l.envios}×</span>}<a class="lead__wa" href={wa(l.whatsapp)} target="_blank" rel="noopener" title="Abrir conversa no WhatsApp">{fone(l.whatsapp)}</a></div></div></td>
            <td>{l.pagina ? <a class="tag acc" href={link({ pagina: l.pagina, p: 1 })}>{nomePagina(l.pagina)}</a> : <span class="mut">—</span>}</td>
            <td class="utm">{l.utm_source || <span class="mut">(direto)</span>}</td>
            <td class="dim opc">{NOME_DISP[l.dispositivo] ?? l.dispositivo ?? '—'}</td>
            {[l.utm_medium, l.utm_campaign, l.utm_content, l.utm_term].map((valor) => <td class="utm">{valor || <span class="mut">—</span>}</td>)}
            <td class="dim">{dt(l.created_at)}</td>
          </tr>)}
        </tbody></table></div>
        {paginas > 1 && (
          <nav class="paginas" aria-label="Páginas da lista">
            {pag > 1 ? <a class="btn sec" href={link({ p: pag - 1 })}>← Anteriores</a> : <span></span>}
            <span class="mut">Página {Math.min(pag, paginas)} de {paginas}</span>
            {pag < paginas ? <a class="btn sec" href={link({ p: pag + 1 })}>Próximos →</a> : <span></span>}
          </nav>
        )}
      </>
    )}
  </div>
</Admin>

<script>
  // Os seletores filtram na hora; a busca filtra ao apertar Enter
  const form = document.getElementById('filtros') as HTMLFormElement | null;
  form?.querySelectorAll('select').forEach((s) => s.addEventListener('change', () => form.requestSubmit()));
  // Não manda campos vazios na URL
  form?.addEventListener('formdata', (e) => { for (const [k, v] of [...e.formData.entries()]) if (v === '') e.formData.delete(k); });
</script>

<style>
  .filtros{display:flex;flex-direction:column;gap:10px;margin-bottom:16px}
  .filtros .busca{max-width:340px}
  .filtros__sel{display:flex;flex-wrap:wrap;gap:8px}
  .lista__topo{display:flex;justify-content:space-between;gap:12px;padding:12px 16px;font-size:13px;color:var(--ink-2);border-bottom:1px solid var(--line)}
  .lista{table-layout:fixed;min-width:900px}
  .lista th,.lista td{padding-left:10px;padding-right:10px;white-space:normal;overflow-wrap:anywhere}
  .lista td{padding-top:11px;padding-bottom:11px}
  .lead>div{min-width:0}
  .lead{display:flex;align-items:center;gap:11px}
  .lead__av{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--acc-soft);color:var(--acc-ink);font-weight:600;font-size:13px;flex:none}
  .lead b{font-weight:600}
  .lead__wa{display:block;font-size:12.5px;color:var(--mut);font-variant-numeric:tabular-nums}
  .lead__wa:hover{color:var(--ok)}
  .lista .utm{white-space:normal;overflow-wrap:anywhere}
  .tag.acc:hover{text-decoration:none;filter:brightness(.97)}
  @media (max-width:700px){.lista .opc{display:none} .filtros .busca{max-width:none}}
  .paginas{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 16px;border-top:1px solid var(--line);font-size:13px}
</style>
