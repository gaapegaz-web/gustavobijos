---
/**
 * Visão geral da captação do site inteiro (todas as páginas e formulários, não só uma campanha):
 * números do período com comparação, gráfico por dia, funil, cadastros por página e os últimos leads.
 * As outras abas (Leads, Origem, Comportamento, Meta, Links) ficam em /admin/<aba>.
 */
import Admin from '~/layouts/Admin.astro';
import { db } from '~/lib/db';
import { brl } from '~/lib/texto';
import { periodo, statusMeta, pct, seg, num, dt, nomePagina, fone } from '~/lib/painel';

const d = db();
const P = periodo(Astro.url);
const { dias, desde, desdeAnterior, temAnterior, rotulo, rotuloAnterior, q, q1 } = P;
const { alertas } = statusMeta(desde);

/* ---------- Números do período (e do período anterior, para comparar) ---------- */
const SQL_SESSOES = `SELECT count(*) sessoes, count(DISTINCT visitante_id) visitantes, sum(scroll_max >= 50) rolou50, sum(abriu_form) abriu, sum(iniciou_form) iniciou,
  sum(lead_id IS NOT NULL) leads_sessao, sum(clicou_grupo) grupo, sum(clicou_checkout) checkout, avg(tempo_ativo_s) ativo, avg(scroll_max) scroll
  FROM sessoes WHERE robo = 0 AND created_at >= datetime('now', ?)`;
const s = q1(SQL_SESSOES);
const sAnt = temAnterior ? (d.prepare(`${SQL_SESSOES} AND created_at < datetime('now', ?)`).get(desdeAnterior, desde) as any) : null;
const robos = q1<any>(`SELECT count(*) n FROM sessoes WHERE robo = 1 AND created_at >= datetime('now', ?)`).n;

/* Pessoas: o mesmo cookie (ta_vid) OU o mesmo IP + navegador contam como uma pessoa só.
   Pega quem abriu em aba anônima ou apagou o cookie. IP sozinho não basta: operadora de celular põe muita gente no mesmo IP. */
const pessoas = (() => {
  const rows = q<{ vid: string; chave: string | null }>(`SELECT visitante_id vid, CASE WHEN ip IS NOT NULL THEN ip || '|' || coalesce(user_agent,'') END chave FROM sessoes WHERE robo = 0 AND created_at >= datetime('now', ?)`);
  const pai = new Map<string, string>();
  const raiz = (x: string): string => { let r = x; while (pai.get(r) !== r) r = pai.get(r)!; pai.set(x, r); return r; };
  const une = (a: string, b: string) => { for (const x of [a, b]) if (!pai.has(x)) pai.set(x, x); pai.set(raiz(a), raiz(b)); };
  for (const r of rows) { une('v:' + r.vid, 'v:' + r.vid); if (r.chave) une('v:' + r.vid, 'i:' + r.chave); }
  const visitas = new Map<string, number>();
  for (const r of rows) { const k = raiz('v:' + r.vid); visitas.set(k, (visitas.get(k) ?? 0) + 1); }
  const v = [...visitas.values()];
  return { n: v.length, duas: v.filter((x) => x === 2).length, mais: v.filter((x) => x >= 3).length };
})();
const SQL_LEADS = `SELECT count(*) n, coalesce(sum(comprou),0) compraram, coalesce(sum(envios - 1), 0) repetidos, coalesce(sum(meta_lead = 0),0) mesmo_aparelho FROM leads WHERE created_at >= datetime('now', ?)`;
const leads = q1<any>(SQL_LEADS);
const leadsAnt = temAnterior ? (d.prepare(`${SQL_LEADS} AND created_at < datetime('now', ?)`).get(desdeAnterior, desde) as any) : null;
const SQL_VENDAS = `SELECT count(*) n, coalesce(sum(valor),0) v FROM eventos WHERE tipo='Purchase' AND created_at >= datetime('now', ?)`;
const vendas = q1<any>(SQL_VENDAS);
const vendasAnt = temAnterior ? (d.prepare(`${SQL_VENDAS} AND created_at < datetime('now', ?)`).get(desdeAnterior, desde) as any) : null;
const reembolsos = q1<any>(`SELECT count(*) n FROM eventos WHERE tipo='Reembolso' AND created_at >= datetime('now', ?)`).n;

/** Variação em relação ao período anterior: null quando não dá para comparar. */
const delta = (atual: number, anterior: number | null | undefined) => {
  if (!temAnterior || anterior == null) return null;
  if (!anterior) return atual ? { texto: 'novo', dir: 1 } : null;
  const p = Math.round(((atual - anterior) / anterior) * 100);
  return { texto: `${p > 0 ? '+' : ''}${p}%`, dir: Math.sign(p) };
};

const funil = [
  { nome: 'Visitas', n: s.sessoes ?? 0 },
  { nome: 'Rolaram metade da página', n: s.rolou50 ?? 0 },
  { nome: 'Abriram o formulário', n: s.abriu ?? 0 },
  { nome: 'Começaram a preencher', n: s.iniciou ?? 0 },
  { nome: 'Viraram lead', n: s.leads_sessao ?? 0 },
  { nome: 'Clicaram no grupo', n: s.grupo ?? 0 },
];
// Onde o funil mais perde: a etapa com a menor passagem em relação à anterior
const maiorPerda = funil.slice(1).reduce<{ i: number; p: number } | null>((acc, f, i) => {
  const ant = funil[i].n; if (!ant) return acc;
  const p = pct(f.n, ant); return !acc || p < acc.p ? { i: i + 1, p } : acc;
}, null);

/* ---------- Por página: por onde as visitas entram e onde os leads se cadastram ---------- */
const entradas = Object.fromEntries(q<any>(`SELECT primeira_pagina p, count(*) n FROM sessoes WHERE robo = 0 AND primeira_pagina IS NOT NULL AND created_at >= datetime('now', ?) GROUP BY p`).map((r) => [r.p, r.n]));
const cadastros = Object.fromEntries(q<any>(`SELECT coalesce(pagina,'?') p, count(*) n FROM leads WHERE created_at >= datetime('now', ?) GROUP BY p`).map((r) => [r.p, r.n]));
const porPagina = [...new Set([...Object.keys(entradas), ...Object.keys(cadastros)])]
  .filter((p) => p !== '/obrigado')
  .map((p) => ({ p, visitas: entradas[p] ?? 0, leads: cadastros[p] ?? 0 }))
  .sort((a, b) => b.leads - a.leads || b.visitas - a.visitas);
const maxLeadsPagina = Math.max(1, ...porPagina.map((x) => x.leads));

/* ---------- Série diária contínua (sem buracos): os últimos N dias, do mais antigo ao mais novo ---------- */
const porDia = d.prepare(`SELECT dia, sessoes, leads, abriu_form, clicou_grupo, tempo_ativo_medio_s FROM v_funil_diario LIMIT 31`).all() as any[];
const leadsDia = Object.fromEntries((d.prepare(`SELECT date(created_at,'-3 hours') dia, count(*) n FROM leads GROUP BY dia`).all() as any[]).map((r) => [r.dia, r.n]));
const diasGrafico = dias === 1 ? 7 : Math.min(dias, 30);
const hojeSP = new Date(Date.now() - 3 * 3600_000);
const serie = Array.from({ length: diasGrafico }, (_, i) => {
  const dia = new Date(hojeSP.getTime() - (diasGrafico - 1 - i) * 86400_000).toISOString().slice(0, 10);
  const r = porDia.find((x) => x.dia === dia);
  return { dia, rotulo: `${dia.slice(8, 10)}/${dia.slice(5, 7)}`, sessoes: r?.sessoes ?? 0, leads: leadsDia[dia] ?? r?.leads ?? 0, grupo: r?.clicou_grupo ?? 0 };
});
const maxDia = Math.max(1, ...serie.map((x) => x.sessoes));
/** Caminho SVG de um minigráfico (96×28) para uma lista de valores */
const sparkline = (vals: number[]) => {
  const max = Math.max(1, ...vals); const w = 96, h = 28, p = 3;
  const pts = vals.map((v, i) => [p + (i * (w - 2 * p)) / Math.max(1, vals.length - 1), h - p - (v / max) * (h - 2 * p)] as const);
  return { d: pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' '), fim: pts[pts.length - 1] };
};

const recentes = d.prepare(`SELECT l.id, l.nome, l.whatsapp, l.pagina, l.utm_source, l.comprou, l.created_at, s.clicou_grupo
  FROM leads l LEFT JOIN sessoes s ON s.id = l.sessao_id ORDER BY l.id DESC LIMIT 6`).all() as any[];

const ICO = {
  visitas: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  leads: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/>',
  grupo: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  vendas: '<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>',
};
const kpisPrincipais = [
  { rotulo: 'Visitas', ico: ICO.visitas, cor: 'c', valor: num(s.sessoes ?? 0), detalhe: `${num(pessoas.n)} ${pessoas.n === 1 ? 'pessoa' : 'pessoas'}${robos ? ` · ${num(robos)} robôs fora da conta` : ''}`, delta: delta(s.sessoes ?? 0, sAnt?.sessoes), serie: serie.map((x) => x.sessoes) },
  { rotulo: 'Leads', ico: ICO.leads, cor: 'a', valor: num(leads.n ?? 0), detalhe: `${pct(s.leads_sessao ?? 0, s.sessoes ?? 0)}% das visitas`, delta: delta(leads.n ?? 0, leadsAnt?.n), serie: serie.map((x) => x.leads) },
  { rotulo: 'Clicaram no grupo', ico: ICO.grupo, cor: 'b', valor: num(s.grupo ?? 0), detalhe: `${pct(s.grupo ?? 0, s.leads_sessao ?? 0)}% dos leads`, delta: delta(s.grupo ?? 0, sAnt?.grupo), serie: serie.map((x) => x.grupo) },
  { rotulo: 'Vendas', ico: ICO.vendas, cor: 'd', valor: num(vendas.n), detalhe: `${brl(vendas.v)}${reembolsos ? ` · ${reembolsos} ${reembolsos === 1 ? 'reembolso' : 'reembolsos'}` : ''}`, delta: delta(vendas.n, vendasAnt?.n), serie: null },
];
const kpisSecundarios = [
  { rotulo: 'Voltaram', valor: num(pessoas.duas + pessoas.mais), detalhe: `${pessoas.duas} vieram 2×, ${pessoas.mais} vieram 3× ou mais` },
  { rotulo: 'Tempo ativo médio', valor: seg(s.ativo) || '—', detalhe: 'por visita, com a aba em foco' },
  { rotulo: 'Rolagem média', valor: `${Math.round(s.scroll ?? 0)}%`, detalhe: 'da altura da página' },
  { rotulo: 'Cadastros repetidos', valor: num(leads.repetidos ?? 0), detalhe: (leads.mesmo_aparelho ?? 0) > 0 ? `bloqueados · ${leads.mesmo_aparelho} do mesmo aparelho` : 'bloqueados' },
  { rotulo: 'Leads que compraram', valor: `${pct(leads.compraram ?? 0, leads.n ?? 0)}%`, detalhe: `${num(leads.compraram ?? 0)} de ${num(leads.n ?? 0)}` },
];
const svg = (paths: string, t = 15) => `<svg width="${t}" height="${t}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
const ALERTA = svg('<path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>', 17);
---
<Admin titulo="Visão geral" ativo="geral" periodo={dias} sub={`Captação do site inteiro: todas as páginas e formulários, ${rotulo}${temAnterior ? `, comparado com os ${rotuloAnterior}` : ''}.`}>

  {alertas.map((a) => <div class="aviso err" role="alert"><Fragment set:html={ALERTA} /><div>{a}</div></div>)}

  <div class="kpis">
    {kpisPrincipais.map((k) => {
      const sp = k.serie ? sparkline(k.serie) : null;
      return (
        <div>
          <span class="kpi__rot"><span class={`kpi__ico ${k.cor}`}><Fragment set:html={svg(k.ico)} /></span>{k.rotulo}</span>
          <div class="kpi__linha">
            <span class="kpi__val">{k.valor}{k.delta && <span class={`kpi__delta ${k.delta.dir > 0 ? 'up' : k.delta.dir < 0 ? 'down' : ''}`} title={`em relação aos ${rotuloAnterior}`}>{k.delta.dir > 0 ? '↑' : k.delta.dir < 0 ? '↓' : '→'} {k.delta.texto}</span>}</span>
            {sp && <svg class="kpi__spark" viewBox="0 0 96 28" aria-hidden="true"><path d={sp.d} /><circle cx={sp.fim[0]} cy={sp.fim[1]} r="3" /></svg>}
          </div>
          <span class="kpi__det">{k.detalhe}</span>
        </div>
      );
    })}
  </div>
  <div class="kpis k5" style="margin-top:14px">
    {kpisSecundarios.map((k) => <div><span class="kpi__rot">{k.rotulo}</span><div class="kpi__linha"><span class="kpi__val">{k.valor}</span></div><span class="kpi__det">{k.detalhe}</span></div>)}
  </div>

  <section>
    <div class="card chart">
      <div class="chart__h"><h3>Por dia <small>visitas e leads, últimos {diasGrafico} dias</small></h3><div class="legenda"><span><i class="v"></i>Visitas</span><span><i class="l"></i>Leads</span></div></div>
      {serie.some((x) => x.sessoes || x.leads) ? (
        <>
          <div class="cols"><span class="eixo-y">{maxDia}</span>
            {serie.map((x) => (
              <div class="col">
                <i class="v" style={`height:${(x.sessoes / maxDia) * 100}%`}></i>
                <i class="l" style={`height:${(x.leads / maxDia) * 100}%`}></i>
                <span class="tip"><b>{x.rotulo}</b>{x.sessoes} visitas · {x.leads} leads{x.grupo ? ` · ${x.grupo} no grupo` : ''}</span>
              </div>
            ))}
          </div>
          <div class="eixo">{serie.map((x, i) => <span class={i === 0 || i === serie.length - 1 || (serie.length > 10 ? i % 5 === 0 : true) ? 'vis' : ''}>{x.rotulo}</span>)}</div>
        </>
      ) : <p class="mut">Sem visitas nos últimos {diasGrafico} dias. O gráfico aparece assim que alguém abrir o site.</p>}
      <details class="tabela"><summary>Ver tabela por dia</summary>
        <div class="tbl"><table><thead><tr><th>Dia</th><th class="n">Visitas</th><th class="n">Abriram form</th><th class="n">Leads</th><th class="n">Clicaram no grupo</th><th class="n">Tempo ativo médio</th></tr></thead><tbody>
          {porDia.length ? porDia.map((r) => <tr><td>{r.dia.slice(8, 10)}/{r.dia.slice(5, 7)}</td><td class="n">{r.sessoes}</td><td class="n">{r.abriu_form}</td><td class="n">{leadsDia[r.dia] ?? r.leads}</td><td class="n">{r.clicou_grupo}</td><td class="n">{seg(r.tempo_ativo_medio_s)}</td></tr>) : <tr><td colspan="6" class="tbl-vazio">Sem dados ainda.</td></tr>}
        </tbody></table></div>
      </details>
    </div>
  </section>

  <section class="grid g32">
    <div class="card">
      <h3>Funil <small>cada etapa em relação às visitas; entre parênteses, à etapa anterior</small></h3>
      {funil[0].n ? (
        <div class="bars">
          {funil.map((f, i) => (
            <div class:list={['bar', { 'alerta-etapa': maiorPerda && maiorPerda.i === i && maiorPerda.p < 50 }]}>
              <span class="rot">{f.nome}</span>
              <div class="tr"><i style={`width:${pct(f.n, funil[0].n || 1)}%`}></i></div>
              <span class="n"><b>{num(f.n)}</b><small>{pct(f.n, funil[0].n)}%{i > 0 && funil[i - 1].n ? ` (${pct(f.n, funil[i - 1].n)}%)` : ''}</small></span>
            </div>
          ))}
        </div>
      ) : <p class="mut">Sem visitas no período. Troque o período lá em cima.</p>}
      {maiorPerda && maiorPerda.p < 50 && <p class="nota">Maior perda: <b>{funil[maiorPerda.i - 1].nome.toLowerCase()} → {funil[maiorPerda.i].nome.toLowerCase()}</b>, só {maiorPerda.p}% passam.</p>}
    </div>
    <div class="card p0">
      <div class="card__h"><h3>Onde as pessoas se cadastram</h3><span class="mut" style="font-size:12.5px">por página do site</span></div>
      <div class="tbl"><table><thead><tr><th>Página</th><th class="n">Entraram por ela</th><th class="n">Leads</th></tr></thead><tbody>
        {porPagina.length ? porPagina.map((r) => <tr>
          <td>{r.leads > 0 ? <a href={`/admin/leads?pagina=${encodeURIComponent(r.p)}`}>{nomePagina(r.p)}</a> : nomePagina(r.p)}</td>
          <td class="n">{num(r.visitas)}</td>
          <td class="n"><span class="mini"><i style={`width:${pct(r.leads, maxLeadsPagina)}%`}></i></span><b>{num(r.leads)}</b></td>
        </tr>) : <tr><td colspan="3" class="tbl-vazio">Sem visitas no período.</td></tr>}
      </tbody></table></div>
    </div>
  </section>

  <section class="card p0">
    <div class="card__h"><h3>Últimos leads</h3><a href="/admin/leads" style="font-size:13px;font-weight:500">Ver todos →</a></div>
    <div class="tbl"><table><thead><tr><th>Nome</th><th>Página</th><th>Origem</th><th class="c">Grupo</th><th class="c">Comprou</th><th>Quando</th></tr></thead><tbody>
      {recentes.length ? recentes.map((l) => <tr>
        <td><b style="font-weight:600">{l.nome}</b> <span class="mut" style="margin-left:6px">{fone(l.whatsapp)}</span></td>
        <td>{nomePagina(l.pagina)}</td>
        <td class="dim">{l.utm_source || '(direto)'}</td>
        <td class="c">{l.clicou_grupo ? <span class="tag ok">sim</span> : <span class="mut">—</span>}</td>
        <td class="c">{l.comprou ? <span class="tag ok">sim</span> : <span class="mut">—</span>}</td>
        <td class="dim">{dt(l.created_at)}</td>
      </tr>) : <tr><td colspan="6" class="tbl-vazio">Nenhum lead ainda.</td></tr>}
    </tbody></table></div>
  </section>

  <p class="rodape"><span>Visitas de robôs ficam fora de todas as contas.</span><span>Recarregue a página para atualizar.</span></p>
</Admin>

<style>
  .chart__h{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:8px 16px}
  .chart__h h3{margin:0}
  .legenda{display:flex;gap:16px;font-size:12.5px;color:var(--ink-2)}
  .legenda span{display:inline-flex;align-items:center;gap:6px}
  .legenda i{width:10px;height:10px;border-radius:3px}
  .legenda i.v,.col i.v{background:#d9d2c5} .legenda i.l,.col i.l{background:var(--acc)}
  .cols{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);align-items:end;gap:4px;height:180px;margin-top:26px;border-bottom:1px solid var(--line-2);position:relative}
  .cols::before,.cols::after{content:'';position:absolute;left:0;right:0;border-top:1px dashed var(--line);pointer-events:none}
  .cols::before{top:33%} .cols::after{top:66%}
  .col{display:flex;align-items:flex-end;justify-content:center;gap:2px;height:100%;position:relative}
  .col i{display:block;flex:1;max-width:22px;border-radius:4px 4px 0 0}
  .col i[style="height:0%"]{display:none}
  .col:hover i.v{background:#c9c0b0}
  .col .tip{position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;border-radius:var(--r-sm);padding:6px 10px;font-size:12px;white-space:nowrap;display:none;z-index:2}
  .col .tip b{display:block;color:#bdb6a9;font-weight:500;font-size:11px}
  .col:hover .tip{display:block}
  .col:first-child .tip{left:0;transform:none} .col:last-child .tip{left:auto;right:0;transform:none}
  .eixo{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:4px;font-size:11px;color:var(--mut);text-align:center;font-variant-numeric:tabular-nums;margin-top:6px}
  .eixo span{visibility:hidden;white-space:nowrap;display:flex;justify-content:center} .eixo span:first-child{justify-content:flex-start} .eixo span:last-child{justify-content:flex-end}
  @media (max-width:640px){.eixo span.vis{visibility:hidden} .eixo span:first-child,.eixo span:last-child{visibility:visible}} .eixo span.vis{visibility:visible}
  .eixo-y{position:absolute;top:-18px;right:0;font-size:11px;color:var(--mut);font-variant-numeric:tabular-nums}
  .eixo-y::before{content:'máx. '}
</style>
