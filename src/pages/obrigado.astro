---
import Honey from '~/layouts/Honey.astro';
import { ENV } from '~/lib/env';
import { CAMPANHA } from '~/config/black';
import { fmtDataHora, fmtDiaSemana } from '~/lib/phases';

const leadEventId = Astro.url.searchParams.get('e') || undefined;
const grupo = ENV.WHATSAPP_GRUPO_URL;
const live = new Date(CAMPANHA.live.data);
---
<Honey title="Falta um passo: entre no grupo" noindex leadEventId={leadEventId}>
  {!grupo.startsWith('#') && <meta http-equiv="refresh" content={`4;url=${grupo}`} />}
  <main class="faixa faixa-mel" style="min-height:100vh;display:flex;align-items:center">
    <div class="wrap" style="max-width:620px">
      <p class="apoio" style="font-family:var(--titulo);font-weight:700;font-size:1.2rem">Cadastro feito</p>
      <h1>Agora entre no grupo</h1>
      <p class="grande" style="color:var(--madeira)">É lá que chega o link da live de {fmtDiaSemana(live)}, {fmtDataHora(live)}, e a condição de abertura da Black antes de todo mundo.</p>
      <a class="botao botao-propolis" href={grupo} id="btn-grupo" data-track-click="Schedule" data-track-params='{"content_name":"entrar_grupo"}' style="width:100%;max-width:420px;font-size:1.15rem;min-height:64px;margin-top:8px">Entrar no grupo do WhatsApp</a>
      <p class="nota" style="color:var(--madeira)">O WhatsApp abre sozinho em alguns segundos. Se não abrir, toque no botão.</p>
    </div>
  </main>
</Honey>
