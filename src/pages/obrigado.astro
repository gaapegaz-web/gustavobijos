---
import Tecnoapis from '~/layouts/Tecnoapis.astro';
import { ENV } from '~/lib/env';
import { CAMPANHA } from '~/config/black';
import { fmtDataHora, fmtDiaSemana } from '~/lib/phases';

const leadEventId = Astro.url.searchParams.get('e') || undefined;
const grupo = ENV.WHATSAPP_GRUPO_URL;
const live = new Date(CAMPANHA.live.data);
---
<Tecnoapis title="Falta um passo: entre no grupo" noindex leadEventId={leadEventId}>
  {!grupo.startsWith('#') && <meta http-equiv="refresh" content={`4;url=${grupo}`} />}
  <main class="ta-section" style="min-height:100vh;display:flex;align-items:center">
    <div class="ta-container" style="max-width:640px">
      <div class="ta-stack">
        <span class="ta-eyebrow">Cadastro feito</span>
        <span class="ta-line ta-line--l">Agora entre no</span>
        <h1 class="ta-impact ta-impact--xl">Grupo</h1>
      </div>
      <p class="ta-lead" style="margin:var(--space-6) 0">É lá que chega o link da live de {fmtDiaSemana(live)}, {fmtDataHora(live)}, e a condição de abertura da Black antes de todo mundo.</p>
      <a class="ta-btn ta-btn--primary ta-btn--lg" href={grupo} id="btn-grupo" data-track-click="Schedule" data-track-params='{"content_name":"entrar_grupo"}' style="width:100%;max-width:420px">Entrar no grupo do WhatsApp</a>
      <p class="ta-small" style="margin-top:var(--space-3)">O WhatsApp abre sozinho em alguns segundos. Se não abrir, toque no botão.</p>
    </div>
  </main>
</Tecnoapis>
