---
/**
 * /bio: página de links para a bio do Instagram (estrutura inspirada no LittleLink, com o design system Tecnoapis).
 * Os links ficam em src/config/bio.ts; o WhatsApp de suporte vem do .env. Foto opcional: public/img/gustavo-avatar.*
 * Miniaturas opcionais (webp/jpg/png, quadradas): public/img/bio-black.* (logo da Black) e public/img/bio-gustavo.* (foto do "Quem é").
 * O link do Clube usa a logo com fundo branco (public/img/logo-clube-fundo.webp).
 * Depois de pôr a imagem, rode o build (em produção ela só existe depois dele).
 */
import Tecnoapis from '~/layouts/Tecnoapis.astro';
import Icons from '~/components/Icons.astro';
import { LINKS_BIO } from '~/config/bio';
import { SITE } from '~/config/site';
import { ENV } from '~/lib/env';
import { acharImagem } from '~/lib/imagens';

export const prerender = false;

const avatar = acharImagem('gustavo-avatar') ?? acharImagem('gustavo');
const suporte = ENV.WHATSAPP_SUPORTE_URL;
// Miniatura no lugar do ícone; sem arquivo, cai no logo atual da Black / no ícone padrão
const miniaturas: Record<string, { src: string; larga?: boolean } | undefined> = {
  black: acharImagem('bio-black') ? { src: acharImagem('bio-black')! } : { src: '/img/black-friday-logo.webp', larga: true },
  clube: acharImagem('logo-clube-fundo') ? { src: acharImagem('logo-clube-fundo')! } : undefined,
  gustavo: (acharImagem('bio-gustavo') ?? avatar) ? { src: (acharImagem('bio-gustavo') ?? avatar)! } : undefined,
};
// Ícones com a cor da marca (estilo ícone de app)
const MARCAS = ['youtube', 'whatsapp', 'instagram'];
const links = [
  ...LINKS_BIO,
  ...(suporte ? [{ id: 'whatsapp', titulo: 'Fale com a equipe no WhatsApp', sub: 'Dúvidas e suporte', href: suporte, icone: 'whatsapp' as const, externo: true }] : []),
];
---
{/* noindex: é só uma lista de links (Instagram); concorria com a home na busca pelo nome. Os links continuam contando (follow). */}
<Tecnoapis title={`${SITE.apelido} | Links`} preload="/img/bio-fundo.webp" description={`Links oficiais de ${SITE.apelido}: ${SITE.clube}, canal no YouTube e contato.`} noindex>
  <main class="bio">
    <div class="bio__deco" aria-hidden="true">
      <img class="bio__girassol" src="/img/bio-girassol.webp" alt="" width="300" height="548" decoding="async" />
      <img class="bio__abelha bio__abelha--1" src="/img/bio-abelha.webp" alt="" width="128" height="92" decoding="async" />
      <img class="bio__abelha bio__abelha--2" src="/img/bio-abelha.webp" alt="" width="128" height="92" decoding="async" />
    </div>
    <div class="bio__in">
      <header class="bio__topo">
        {avatar
          ? <img class="bio__avatar" src={avatar} alt={SITE.apelido} width="80" height="80" />
          : <span class="bio__avatar bio__avatar--sigla" aria-hidden="true">GB</span>}
        <div class="bio__nome">
          <h1>Gustavo <em>Bijos</em></h1>
          <p><span>Apicultor há 27 anos</span> <span>Criador do {SITE.clube}</span></p>
        </div>
      </header>

      <nav class="bio__links" aria-label="Links">
        {links.map((l) => (
          <a class:list={['bio__link', { 'bio__link--destaque': l.destaque }]} href={l.href} {...(l.externo ? { target: '_blank', rel: 'noopener' } : {})}
            data-track-click="CliqueBio" data-track-params={JSON.stringify({ content_name: l.id })}>
            {miniaturas[l.id]
              ? <span class:list={['bio__icone bio__icone--img', { 'bio__icone--larga': miniaturas[l.id]!.larga }]}><img src={miniaturas[l.id]!.src} alt="" width="44" height="44" /></span>
              : MARCAS.includes(l.icone)
                ? <span class={`bio__icone bio__icone--${l.icone}`}>{l.icone === 'youtube' ? <svg aria-hidden="true" width="26" height="19" viewBox="0 0 28 20"><path fill="#ff0000" d="M27.4 3.1A3.5 3.5 0 0 0 24.9.6C22.7 0 14 0 14 0S5.3 0 3.1.6A3.5 3.5 0 0 0 .6 3.1C0 5.3 0 10 0 10s0 4.7.6 6.9a3.5 3.5 0 0 0 2.5 2.5C5.3 20 14 20 14 20s8.7 0 10.9-.6a3.5 3.5 0 0 0 2.5-2.5c.6-2.2.6-6.9.6-6.9s0-4.7-.6-6.9z"/><path fill="#fff" d="M11.2 14.3 18.5 10l-7.3-4.3z"/></svg> : <Icons name={l.icone} size={22} />}</span>
                : <span class="bio__icone"><Icons name={l.icone} size={20} /></span>}
            <span class="bio__txt"><b>{l.titulo}</b>{l.sub && <small>{l.sub.split(' · ').map((t) => <span>{t}</span>)}</small>}</span>
          </a>
        ))}
      </nav>
    </div>
  </main>
</Tecnoapis>

<style>
  /* Ocupa a tela inteira sem rolar: os botões esticam para preencher a altura. Fundo: textura de abelhas (bio-fundo.webp) com o brilho dourado no topo */
  .bio { min-height: 100svh; min-height: 100dvh; display: flex; background: radial-gradient(90% 50% at 50% 0%, rgba(42,30,6,.85) 0%, rgba(10,10,10,0) 70%), url('/img/bio-fundo.webp') center / cover no-repeat, #0f1016; padding: var(--space-6) var(--gutter) max(var(--space-4), env(safe-area-inset-bottom)); }
  .bio { position: relative; overflow: hidden; isolation: isolate; }
  /* Decoração (public/img/bio-girassol.webp e bio-abelha.webp): girassol subindo do canto, atrás dos cards de vidro; abelhas voando no topo */
  .bio__deco { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .bio__deco img { position: absolute; display: block; height: auto; }
  .bio__girassol { right: max(-34px, calc(50% - 300px)); bottom: -24px; width: clamp(150px, 42vw, 190px); transform: rotate(-7deg); transform-origin: bottom center; opacity: .9; }
  .bio__abelha { width: 44px; animation: bio-voo 3.2s ease-in-out infinite; }
  .bio__abelha--1 { top: 6px; right: max(var(--gutter), calc(50% - 232px)); }
  .bio__abelha--2 { top: 84px; right: max(54px, calc(50% - 190px)); width: 28px; opacity: .85; animation-duration: 2.6s; animation-delay: -1.1s; }
  @keyframes bio-voo { 0%, 100% { transform: translate(0, 0) rotate(-4deg); } 50% { transform: translate(-6px, -7px) rotate(3deg); } }
  @media (prefers-reduced-motion: reduce) { .bio__abelha { animation: none; } }
  .bio__in { flex: 1; width: 100%; max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-5); }
  .bio__topo { display: flex; align-items: center; gap: var(--space-4); }
  .bio__avatar { flex: 0 0 80px; width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); }
  .bio__avatar--sigla { display: flex; align-items: center; justify-content: center; background: var(--surface); color: var(--accent-ink); font: 700 30px/1 var(--font-display); }
  .bio__nome { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .bio h1 { font: 700 28px/1.05 var(--font-display); letter-spacing: -.01em; color: var(--ink); white-space: nowrap; }
  .bio h1 em { font-style: normal; color: var(--accent-ink); }
  .bio__nome p { display: flex; flex-direction: column; font: 400 14px/1.4 var(--font-sans); color: var(--ink-muted); }
  .bio__nome p span { white-space: nowrap; }
  .bio__links { flex: 1; width: 100%; display: flex; flex-direction: column; gap: var(--space-2); }
  .bio__link { flex: 1 1 56px; display: flex; align-items: center; gap: var(--space-3); min-height: 56px; padding: var(--space-2) var(--space-3); background: rgba(27,27,27,.74); -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px); border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--ink); text-decoration: none; transition: border-color .15s, transform .1s; }
  .bio__link:hover { border-color: var(--accent); }
  .bio__link:active { transform: translateY(1px); }
  /* Link da campanha: maior, com brilho passando pelo fundo; borda, halo e o card pulsam juntos */
  .bio__link--destaque { position: relative; overflow: hidden; isolation: isolate; flex-grow: 1.5; background: linear-gradient(135deg, #ffc93c 0%, var(--accent) 45%, #e89a00 100%); border: 2px solid #ffd25e; color: var(--on-accent); animation: bio-halo 1.6s ease-in-out infinite; }
  .bio__link--destaque::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.65) 50%, transparent 70%); transform: translateX(-100%); animation: bio-brilho 3s ease-in-out infinite; }
  @keyframes bio-brilho { 0% { transform: translateX(-100%); } 55%, 100% { transform: translateX(100%); } }
  @keyframes bio-halo { 0%, 100% { transform: scale(1); border-color: #ffd25e; box-shadow: 0 0 0 0 rgba(255,190,30,.4), 0 0 16px rgba(255,190,30,.25); } 50% { transform: scale(1.025); border-color: #fff4c2; box-shadow: 0 0 0 5px rgba(255,190,30,.22), 0 0 38px rgba(255,190,30,.6); } }
  @media (prefers-reduced-motion: reduce) { .bio__link--destaque, .bio__link--destaque::before { animation: none; } .bio__link--destaque { box-shadow: 0 0 26px rgba(255,190,30,.45); } }
  .bio__icone { flex: 0 0 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); background: var(--surface); color: var(--accent-ink); }
  .bio__link--destaque .bio__icone { background: rgba(0,0,0,.12); color: var(--on-accent); }
  .bio__link--destaque .bio__icone :global(svg) { fill: currentColor; }
  .bio__icone--img { overflow: hidden; background: #0a0a0a; }
  .bio__icone--img img { width: 100%; height: 100%; object-fit: cover; }
  .bio__icone--larga { flex-basis: 60px; height: 40px; padding: 2px 3px; }
  .bio__icone--larga img { object-fit: contain; }
  .bio__icone--whatsapp, .bio__icone--instagram { color: #fff; border-radius: 10px; }
  .bio__icone--whatsapp { background: #25d366; }
  .bio__icone--instagram { background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%); }
  .bio__txt { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .bio__txt b { font: 600 clamp(14px, 3.9vw, 15px)/1.25 var(--font-sans); text-wrap: balance; }
  /* Linha de apoio: cada trecho entre "·" fica inteiro e só quebra entre trechos. Todo trecho começa com "·"
     numa caixa de 1em; a caixa recuada e cortada à esquerda esconde o "·" de quem abre linha. */
  .bio__txt small { display: flex; flex-wrap: wrap; margin-left: -1em; clip-path: inset(0 0 0 1em); font: 400 clamp(12px, 3.4vw, 13px)/1.3 var(--font-sans); color: var(--ink-muted); }
  .bio__txt small span { white-space: nowrap; }
  .bio__txt small span::before { content: '·'; display: inline-block; width: 1em; text-align: center; }
  .bio__link--destaque small { color: rgba(10,10,10,.72); }
</style>
