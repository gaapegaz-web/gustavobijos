---
/** Variantes de captação por canal/criativo: /c/<variante>. Mesma página, título diferente. */
import Captacao from '~/components/Captacao.astro';

const VARIANTES: Record<string, { linha: string; impacto: string; spaced: string; sub: string }> = {
  iniciante: { linha: 'Tem menos de 10', impacto: 'Colmeias', spaced: 'e quer crescer', sub: 'A live mostra o caminho de quem começou pequeno e chegou a 100 colmeias com multiplicação própria, sem comprar enxame.' },
  rainhas: { linha: 'Pare de comprar', impacto: 'Rainha', spaced: 'produza as suas', sub: 'Live gratuita: o método de rainhas mais simples para quem quer ir de 10 para 100 colmeias.' },
  renda: { linha: 'Quantas colmeias para', impacto: 'Viver', spaced: 'de apicultura', sub: 'Na live: o plano de 10 para 100 colmeias e a conta de quanto isso rende por temporada.' },
};

const v = String(Astro.params.variante || '').toLowerCase();
const cfg = VARIANTES[v];
if (!cfg) return Astro.redirect('/', 302);
---
<Captacao variante={v} {...cfg} />
