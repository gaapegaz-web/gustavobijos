---
import { CAMPANHA } from '~/config/black';
import Icons from './Icons.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
const bio = CAMPANHA.professorBio;
// Foto: public/img/gustavo.(webp|jpg|png), vertical 4:5. Sem ela, aparece um espaço reservado.
const pasta = import.meta.env.PROD ? 'dist/client' : 'public';
const foto = ['webp', 'jpg', 'png'].map((ext) => `/img/gustavo.${ext}`).find((f) => existsSync(join(process.cwd(), pasta, f)));
---
<section class="ta-section ta-section--light" data-theme="light" id="quem-ensina" data-secao="4-gustavo">
  <div class="ta-container autor">
    <div class="autor__foto">
      {foto
        ? <img src={foto} alt={CAMPANHA.professor} width="480" height="600" loading="lazy" />
        : <div class="autor__vazio">Foto do Gustavo</div>}
    </div>
    <div class="autor__texto">
      <h2 class="display-l">Gustavo Bijos, {bio.anos}&nbsp;anos de apicultura</h2>
      <p class="ta-lead">{bio.resumo}</p>
      <ul class="ta-list">
        {bio.cargos.map((c) => <li><Icons name="check" /><span>{c}</span></li>)}
      </ul>
      <p class="ta-body">{bio.palestras}</p>
      <p class="ta-body">Hoje o Clube tem 25 cursos, mais de 130 horas e 115 lives gravadas.</p>
    </div>
  </div>
</section>
<style>
  .autor { display: grid; gap: var(--space-8); }
  .autor__foto { width: 100%; max-width: 320px; margin-inline: auto; }
  .autor__vazio { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 5; border: 2px dashed rgba(0,0,0,.2); border-radius: var(--radius-lg); background: rgba(0,0,0,.04); font: 500 14px/1 var(--font-sans); color: #777; }
  .autor__foto img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-lg); }
  .autor__texto { display: flex; flex-direction: column; gap: var(--space-6); }
  @media (min-width: 900px) { .autor { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-16); align-items: start; } .autor__foto { max-width: none; position: sticky; top: 96px; } }
</style>
