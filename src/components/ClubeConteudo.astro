---
/** "O que tem no Clube Tecnoapis": os números em destaque e o carrossel com as capas dos cursos.
 *  A lista completa por área (AREAS) não aparece mais aqui: ocupava muito espaço. Ela segue no llms.txt e no JSON-LD da /tecnoapis. */
import CarrosselCapas from './CarrosselCapas.astro';
import { NUMEROS } from '~/config/clube';
interface Props { titulo?: string; lead?: string }
const {
  titulo = 'O que tem no <em>Clube Tecnoapis</em>',
  lead = 'Teoria e prática gravadas no apiário, do primeiro núcleo à venda do mel.',
} = Astro.props;
const destaques = [...NUMEROS, { n: 'Ao vivo', l: 'live nova toda segunda' }];
---
<section class="ta-section ta-section--surface clube" id="clube" data-secao="2-clube">
  <div class="ta-container">
    <div class="ta-intro ta-intro--center clube__topo">
      <span class="ta-pill">Clube Tecnoapis</span>
      <h2 class="display-l" set:html={titulo} />
      <p class="ta-lead">{lead}</p>
    </div>

    <ul class="clube__numeros" aria-label="O Clube em números">
      {destaques.map((x) => <li><b>{x.n}</b><span>{x.l}</span></li>)}
    </ul>
  </div>

  <CarrosselCapas />
</section>

<style>
  .clube__topo { display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
  .clube__topo :global(em) { font-style: normal; color: var(--accent); }
  .clube__topo .ta-lead { margin-inline: auto; text-wrap: balance; }

  /* Números em destaque: 2×2 no celular, 4 em linha no computador */
  .clube__numeros { list-style: none; margin: var(--space-8) auto 0; padding: 0; max-width: 960px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .clube__numeros li { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 22px 10px; text-align: center; border: 1px solid rgba(242,169,0,.3); border-radius: var(--radius-lg); background: linear-gradient(180deg, rgba(242,169,0,.12), rgba(242,169,0,.03)); }
  .clube__numeros b { font: 700 clamp(40px, 12vw, 64px)/1 var(--font-display); letter-spacing: -.01em; color: var(--accent); }
  .clube__numeros span { font: 500 14px/1.3 var(--font-sans); color: var(--ink); }
  .clube__numeros li:last-child { background: var(--accent); border-color: var(--accent); }
  .clube__numeros li:last-child b { font-size: clamp(30px, 8.5vw, 46px); color: var(--on-accent); }
  .clube__numeros li:last-child span { color: var(--on-accent); font-weight: 600; }
  @media (min-width: 900px) {
    .clube__numeros { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: var(--space-10, 56px); }
    .clube__numeros li { padding: 30px 16px; }
    .clube__numeros span { font-size: 15px; }
  }
</style>
