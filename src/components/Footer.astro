---
import { CAMPANHA } from '~/config/black';
import AjudaWhatsapp from './AjudaWhatsapp.astro';
---
<footer class="ta-footer">
  <div class="ta-container">
    <AjudaWhatsapp class="footer__ajuda" texto="Dúvida ou problema na inscrição, a equipe do Gustavo responde no WhatsApp." nome="suporte" />
    <p class="ta-small"><span class="ta-ink" style="font-weight:500">{CAMPANHA.clube}</span>, {CAMPANHA.professor}</p>
    <p class="ta-small">Este site não é afiliado ao Facebook, Instagram ou Meta. Resultados variam com dedicação, região e manejo. © {new Date().getFullYear()} · <a href="/termos">Termos de uso</a> · <a href="/privacidade">Política de privacidade</a></p>
  </div>
</footer>

<style>
  :global(.footer__ajuda) { margin-bottom: var(--space-8); }
  .ta-footer a { color: inherit; text-underline-offset: 3px; }
</style>
