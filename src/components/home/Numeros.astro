---
/** Faixa clara com os números grandes (referência: faixa de números do ericorocha.com.br). */
import { NUMEROS_PROFESSOR } from '~/config/site';
---
<section class="numeros" data-theme="light" data-secao="2-numeros" aria-label="Gustavo Bijos em números">
  <div class="ta-container numeros__grid">
    {NUMEROS_PROFESSOR.map((x) => (
      <div><b>{x.n}<small>{x.sufixo}</small></b><span>{x.l}</span></div>
    ))}
  </div>
</section>

<style>
  .numeros { background: var(--bg); color: var(--ink); padding-block: var(--space-12); }
  .numeros__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8) var(--space-4); }
  .numeros__grid > div { display: flex; flex-direction: column; gap: var(--space-2); border-top: 2px solid var(--honey); padding-top: var(--space-4); }
  .numeros b { font: 500 clamp(40px, 9vw, 56px)/1 var(--font-display); letter-spacing: -.02em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .numeros small { margin-left: 6px; font: 500 15px/1 var(--font-sans); color: var(--accent-ink); letter-spacing: 0; }
  .numeros span { font: 400 14px/1.4 var(--font-sans); color: var(--ink-muted); }
  @media (min-width: 820px) { .numeros { padding-block: var(--space-16); } .numeros__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-8); } }
</style>
