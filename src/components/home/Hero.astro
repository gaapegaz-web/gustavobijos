---
/** Herói: nome grande, frase-tese e foto. Sem foto (public/img/gustavo-hero.*), o lado direito vira só o brilho de fundo. */
import { BIO, SITE } from '~/config/site';
import { acharImagem, srcsetImagem } from '~/lib/imagens';
const foto = acharImagem('gustavo-hero');
const fotoLarga = foto && acharImagem('gustavo-hero-largo');
const srcset = srcsetImagem('gustavo-hero', [720], 1080);
// No celular a foto é uma faixa que mostra só o rosto: recorte do topo, ~3x mais leve (55 KB contra 153 KB)
const fotoCelular = foto && acharImagem('gustavo-hero-celular-720');
const srcsetLarga = srcsetImagem('gustavo-hero-largo', [1280], 1920);
---
<section class:list={['hero', { 'hero--foto': foto }]} data-secao="1-hero">
  {foto && <div class="hero__foto" aria-hidden="true"><picture>{fotoLarga && <source media="(min-width: 900px)" srcset={srcsetLarga} sizes="60vw" width="1920" height="1280" />}<img src={fotoCelular ? '/img/gustavo-hero-celular-720.webp' : foto} srcset={fotoCelular ? '/img/gustavo-hero-celular-480.webp 480w, /img/gustavo-hero-celular-720.webp 720w' : srcset} sizes="100vw" alt="Gustavo Bijos, apicultor e criador do Clube Tecnoapis" width={fotoCelular ? 720 : 1080} height={fotoCelular ? 800 : 1920} fetchpriority="high" /></picture></div>}
  <div class="ta-container hero__body">
    <span class="ta-pill">Apicultor há {BIO.anos} anos</span>
    <h1 class="hero__nome">Gustavo <em>Bijos</em></h1>
    <p class="hero__tese">{BIO.anos} anos de apicultura e o primeiro curso online de apicultura do Brasil.</p>
    <p class="hero__sub">Criador do {SITE.clube}, o curso de apicultura online com 25 cursos e live toda segunda. Já foi instrutor do SENAR e do SEBRAE e ensina do primeiro enxame à multiplicação de colmeias e à produção de rainhas.</p>
    <div class="hero__ctas">
      <a class="ta-btn ta-btn--primary ta-btn--lg" href="#sobre">Conheça o Gustavo</a>
      <a class="ta-btn ta-btn--outline ta-btn--lg" href={SITE.clubeUrl} data-track-click="CliqueClube" data-track-params='{"content_name":"hero"}'>Conheça o {SITE.clube}</a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; background: radial-gradient(70% 60% at 85% 20%, #2a1e06 0%, #0a0a0a 70%); }
  .hero__body { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); padding-block: var(--space-16) var(--space-16); }
  .hero__nome { font: 700 clamp(44px, 12vw, 104px)/.95 var(--font-display); letter-spacing: -.01em; color: var(--ink); }
  .hero__nome em { font-style: normal; color: var(--accent-ink); }
  .hero__tese { font: 400 clamp(19px, 4.6vw, 32px)/1.22 var(--font-display); color: var(--ink); letter-spacing: 0; }
  .hero__sub { max-width: 52ch; font: 400 15px/1.5 var(--font-sans); color: var(--ink-muted); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-1); width: 100%; }
  .hero__foto picture { display: contents; }
  .hero__foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__foto::after { content: ''; position: absolute; inset: 0; }

  /* Celular: tudo na primeira tela (até os botões). A foto é uma faixa no topo que cresce ou encolhe com a altura da tela
     e o texto fica logo abaixo. Medido em 375x553 (iPhone SE com as barras do Safari), 360x640, 390x664 e 412x780. */
  @media (max-width: 899px) {
    .hero--foto { display: flex; flex-direction: column; min-height: 100svh; background: #0a0a0a; }
    .hero__foto { position: relative; flex: 1 1 auto; min-height: 150px; }
    .hero__foto img { object-position: 62% 14%; }
    .hero__foto::after { background: linear-gradient(180deg, rgba(10,10,10,.35) 0%, rgba(10,10,10,0) 28%, rgba(10,10,10,0) 55%, #0a0a0a 100%); }
    .hero--foto .hero__body { flex: none; gap: 10px; margin-top: -24px; padding-block: 0 var(--space-5); }
    .hero__ctas .ta-btn { width: 100%; min-height: 50px; }
  }
  /* Tela baixa (ex.: iPhone SE com as barras do Safari): o selo sai, porque repete a frase de baixo, e sobra espaço para o rosto */
  @media (max-width: 899px) and (max-height: 600px) { .hero--foto .ta-pill { display: none; } }
  @media (min-width: 900px) {
    .hero__body { padding-block: var(--space-24) calc(var(--space-24) + var(--space-8)); gap: var(--space-4); }
    .hero__tese { max-width: 22ch; }
    .hero__sub { font-size: 17px; line-height: 1.6; }
    .hero__ctas { width: auto; gap: var(--space-3); margin-top: var(--space-4); }
    .hero__foto { position: absolute; inset: 0; left: 42%; }
    .hero__foto img { object-position: 70% top; }
    .hero__foto::after { background: linear-gradient(90deg, #0a0a0a 0%, rgba(10,10,10,.55) 30%, rgba(10,10,10,0) 60%), linear-gradient(0deg, #0a0a0a 0%, rgba(10,10,10,0) 30%); }
    .hero--foto .hero__body { padding-top: var(--space-24); min-height: min(86svh, 760px); justify-content: center; }
  }
</style>
