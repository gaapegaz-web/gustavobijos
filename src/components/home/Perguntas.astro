---
/**
 * Perguntas frequentes em acordeão. Sem props, mostra as do Gustavo (home); com `itens`, qualquer lista
 * (ex.: FAQ_CLUBE no /tecnoapis). O mesmo conteúdo vira FAQPage no JSON-LD de cada página.
 */
import { FAQ_PROFESSOR, visiveis } from '~/config/site';
type Item = { p: string; r: string; confirmado?: boolean };
interface Props { preview?: boolean; itens?: Item[]; titulo?: string; pill?: string; id?: string; secao?: string; claro?: boolean }
const { preview = false, titulo = 'Sobre o Gustavo', pill = 'Perguntas frequentes', id = 'perguntas', secao = '6-perguntas', claro = true } = Astro.props;
const itens: Item[] = Astro.props.itens ?? visiveis(FAQ_PROFESSOR, preview);
---
<section class:list={['ta-section', { 'ta-section--light': claro }]} data-theme={claro ? 'light' : undefined} id={id} data-secao={secao}>
  <div class="ta-container perguntas">
    <div class="ta-intro">
      {pill && <span class="ta-pill">{pill}</span>}
      <h2 class="display-l">{titulo}</h2>
    </div>
    <div class="ta-faq">
      {itens.map((f, i) => (
        <details class:list={{ pendente: f.confirmado === false }} open={i === 0}><summary>{f.p}</summary><p>{f.r}</p></details>
      ))}
    </div>
  </div>
</section>

<style>
  .perguntas { display: grid; gap: var(--space-8); }
  @media (min-width: 900px) { .perguntas { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--space-16); } }
</style>
