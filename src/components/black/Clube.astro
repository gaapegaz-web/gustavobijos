---
/**
 * "O Clube Tecnoapis": proposta em faixa creme e os números do Clube em cartões com foto (NumerosClube.astro).
 * Miniaturas do "Prática real" em public/img/clube/clube-mini-*.webp.
 */
import NumerosClube from '../NumerosClube.astro';
const MINIS = ['clube-mini-nucleos', 'clube-mini-quadros', 'clube-mini-propolis'];
---
<section class="bf-secao bf-claro clube" id="clube" data-secao="2-clube">
  <div class="ta-container clube__grid">
    <div>
      <span class="bf-olho">O Clube Tecnoapis</span>
      <h2 class="bf-titulo">Conhecimento que sai da tela e entra no <em>apiário.</em></h2>
      <p class="bf-texto clube__texto">Do manejo das colmeias à gestão do negócio, o Clube reúne aulas gravadas no campo, encontros ao vivo e materiais práticos para quem quer evoluir na apicultura.</p>
      <div class="clube__destaque">
        <span class="clube__minis" aria-hidden="true">
          {MINIS.map((m) => <img src={`/img/clube/${m}.webp`} alt="" width="56" height="56" loading="lazy" decoding="async" />)}
        </span>
        <p><strong>Prática real.</strong><span>Teoria e prática gravadas no apiário, para aplicar no seu dia a dia.</span></p>
      </div>
    </div>
    <NumerosClube colunas={2} />
  </div>
</section>

<style>
  .clube__grid { display: grid; gap: 48px; align-items: center; }
  .clube__texto { margin-top: 20px; }
  .clube__destaque { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin-top: 28px; padding: 18px 20px; border: 1px solid #d6c9b1; border-radius: 20px; background: #ebe2cf; }
  .clube__minis { display: flex; flex: none; }
  .clube__minis img { width: 44px; height: 44px; border: 2px solid #ebe2cf; border-radius: 50%; object-fit: cover; }
  .clube__minis img + img { margin-left: -14px; }
  .clube__destaque p { display: flex; flex-direction: column; gap: 4px; font: 400 14.5px/1.45 var(--font-sans); color: #5b564a; }
  .clube__destaque strong { font: 700 24px/1 var(--font-display); letter-spacing: -.01em; color: var(--bf-ink); }
  @media (min-width: 900px) {
    .clube__grid { grid-template-columns: 1fr 1fr; gap: 72px; }
    .clube__destaque { flex-direction: row; align-items: center; gap: 16px; }
    .clube__minis img { width: 52px; height: 52px; }
  }
</style>
