---
interface Props { variante?: string; pagina?: string; cta?: string; titulo?: string; subtitulo?: string; id?: string }
const { variante = '', pagina = Astro.url.pathname, cta = 'Receber o link no WhatsApp', titulo = 'Garanta sua vaga na live', subtitulo = 'Grátis. O link do grupo chega no seu WhatsApp agora.', id = 'form' } = Astro.props;
const erro = Astro.url.searchParams.get('erro');
const campoErro = Astro.url.searchParams.get('campo');
---
<form class="ta-form lead-form" id={id} method="post" action="/api/lead" novalidate>
  <div>
    <h3>{titulo}</h3>
    {subtitulo && <p class="ta-small" style="margin-top:var(--space-1)">{subtitulo}</p>}
  </div>
  <input type="hidden" name="variante" value={variante} />
  <input type="hidden" name="pagina" value={pagina} />
  <input type="text" name="site" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
  <label class={`ta-field ${campoErro === 'nome' ? 'erro' : ''}`}>
    <span>Seu nome</span>
    <input type="text" name="nome" autocomplete="name" required placeholder="Como quer ser chamado" />
    <div class="msg">{campoErro === 'nome' ? erro : ''}</div>
  </label>
  <label class={`ta-field ${campoErro === 'whatsapp' ? 'erro' : ''}`}>
    <span>Seu WhatsApp com DDD</span>
    <input type="tel" name="whatsapp" inputmode="numeric" autocomplete="tel-national" required placeholder="(67) 99999-9999" />
    <div class="msg">{campoErro === 'whatsapp' ? erro : ''}</div>
  </label>
  <label class={`ta-field ${campoErro === 'email' ? 'erro' : ''}`}>
    <span>Seu e-mail <span class="ta-muted" style="font-weight:300">(se quiser)</span></span>
    <input type="email" name="email" autocomplete="email" placeholder="voce@email.com" />
    <div class="msg">{campoErro === 'email' ? erro : ''}</div>
  </label>
  <label class="ta-consent">
    <input type="checkbox" name="consentimento" value="1" checked required />
    <span>Aceito receber mensagens sobre a live e a Black Tecnoapis no WhatsApp e no e-mail. Posso sair quando quiser.</span>
  </label>
  <button class="ta-btn ta-btn--primary ta-btn--lg" type="submit" data-track-click="Contact" data-track-params='{"content_name":"form_submit"}'><span data-label>{cta}</span></button>
  <p class="ta-small" style="text-align:center">Sem spam. Seus dados ficam só com a equipe do Gustavo.</p>
</form>

<script>
  function mask(v: string) {
    const d = v.replace(/\D/g, '').replace(/^55(?=\d{10,11}$)/, '').slice(0, 11);
    if (d.length <= 2) return d ? `(${d}` : '';
    if (d.length <= 6) return `(${d.slice(0, 2)}) ${d.slice(2)}`;
    if (d.length <= 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
    return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
  }
  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    const tel = form.querySelector<HTMLInputElement>('input[name=whatsapp]')!;
    tel.addEventListener('input', () => { tel.value = mask(tel.value); });
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      const label = btn.querySelector('[data-label]')!;
      const orig = label.textContent;
      form.querySelectorAll('.ta-field').forEach((f) => { f.classList.remove('erro'); f.querySelector('.msg')!.textContent = ''; });
      btn.disabled = true; label.textContent = 'Enviando…';
      try {
        const fd = new FormData(form);
        const body: Record<string, string> = {}; fd.forEach((v, k) => (body[k] = String(v)));
        const res = await fetch('/api/lead', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify(body) });
        const j = await res.json();
        if (j.ok) { label.textContent = 'Pronto, abrindo o WhatsApp…'; location.href = j.redirect; return; }
        const f = form.querySelector(`input[name=${j.campo}]`)?.closest('.ta-field');
        if (f) { f.classList.add('erro'); f.querySelector('.msg')!.textContent = j.erro; (f.querySelector('input') as HTMLInputElement).focus(); }
        else alert(j.erro || 'Não foi possível enviar. Tente de novo.');
      } catch { form.submit(); return; }
      btn.disabled = false; label.textContent = orig;
    });
  });
</script>
