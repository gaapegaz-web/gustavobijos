---
import Honey from '~/layouts/Honey.astro';
import LeadForm from './LeadForm.astro';
import Favo from './Favo.astro';
import { CAMPANHA } from '~/config/black';
import { fmtDataHora, fmtDiaSemana } from '~/lib/phases';

interface Props { variante?: string; headline?: string; sub?: string }
const { variante = '', headline = 'De 10 para 100 colmeias sem comprar um enxame', sub = 'Live gratuita com o Gustavo Bijos: o método de multiplicação, as rainhas próprias e o calendário que leva um apiário pequeno a cem colmeias.' } = Astro.props;

const live = new Date(CAMPANHA.live.data);
const liveJaPassou = new Date() > live;
const quando = `${fmtDiaSemana(live)}, ${fmtDataHora(live)}`;
---
<Honey title={`Live: ${CAMPANHA.live.titulo} | ${CAMPANHA.professor}`} description={sub}>
<main>
  <section class="faixa faixa-mel topo">
    <div class="wrap topo-grid">
      <div class="topo-texto">
        <p class="quando">{liveJaPassou ? 'Live gravada, assista quando quiser' : `Live gratuita · ${quando}`}</p>
        <h1>{headline}</h1>
        <p class="grande" style="color:var(--madeira)">{sub}</p>
      </div>
      <div class="topo-form">
        <LeadForm variante={variante} />
      </div>
      <div class="topo-favo"><Favo /></div>
    </div>
  </section>

  <section class="faixa">
    <div class="wrap duas">
      <div>
        <h2>O que trava o apiário em 10, 15, 20 colmeias</h2>
        <p class="grande apoio">Não é falta de abelha. São três decisões que quase todo apicultor toma errado nos primeiros anos. Na live, o Gustavo mostra cada uma e o que fazer no lugar.</p>
      </div>
      <ul class="lista grande">
        <li><b>Dividir a colmeia errada.</b> Qualquer divisão sem matriz preparada vira dois enxames fracos. Como escolher, preparar e saber quando a matriz está pronta.</li>
        <li><b>Comprar rainha.</b> A 60, 100 reais cada, multiplicar sai caro e lento. O método mais simples para produzir as suas, mesmo começando agora.</li>
        <li><b>Dividir fora do tempo.</b> Núcleo feito longe da florada morre. O calendário de divisão, alimentação e revisão de uma temporada inteira.</li>
      </ul>
    </div>
  </section>

  <section class="faixa faixa-propolis">
    <div class="wrap quem">
      <img src="/img/gustavo.svg" alt={CAMPANHA.professor} width="420" height="420" loading="lazy" />
      <div>
        <h2>Quem ensina</h2>
        <p class="grande"><b style="color:var(--mel)">{CAMPANHA.professor}</b> é professor e apicultor, criador do Clube Tecnoapis. Multiplica o próprio apiário com os métodos que ensina e grava as aulas no campo, não em estúdio.</p>
        <p>No clube são 25 cursos, mais de 130 horas de conteúdo e 115 lives semanais gravadas desde 2023, sobre núcleos, rainhas, própolis, geleia real, alimentação e gestão do apiário como negócio.</p>
      </div>
    </div>
  </section>

  <section class="faixa faixa-mel">
    <div class="wrap fecho">
      <div>
        <h2>Entre no grupo e receba o link da live</h2>
        <p class="grande" style="color:var(--madeira)">Quem está no grupo recebe o lembrete na hora, a gravação depois e, no fim da live, a condição de abertura da Black Tecnoapis antes de todo mundo.</p>
      </div>
      <LeadForm variante={variante} id="form2" titulo="Garanta sua vaga" subtitulo="" />
    </div>
  </section>

  <footer class="rodape">
    <div class="wrap">
      <p><b>{CAMPANHA.clube}</b> · {CAMPANHA.professor}</p>
      <p>Este site não é afiliado ao Facebook, Instagram ou Meta. Resultados variam com dedicação, região e manejo.</p>
    </div>
  </footer>
</main>
</Honey>

<style>
  .topo { padding-top: clamp(28px, 5vw, 64px); }
  .topo-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr); grid-template-areas: 'texto form' 'favo form'; gap: 24px clamp(28px, 5vw, 64px); align-items: start; }
  .topo-texto { grid-area: texto; } .topo-form { grid-area: form; } .topo-favo { grid-area: favo; }
  .quando { font-family: var(--titulo); font-weight: 700; font-size: 1.2rem; color: var(--propolis); margin-bottom: 14px; }
  .topo-texto h1 { max-width: 11ch; }
  .duas { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .quem { display: grid; grid-template-columns: minmax(220px, 360px) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .quem img { border-radius: 12px; aspect-ratio: 1; object-fit: cover; width: 100%; }
  .fecho { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 460px); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .rodape { padding: 28px 0 40px; font-size: .85rem; color: var(--fumaca); }
  .rodape p { max-width: none; margin: 0 0 4px; }
  @media (max-width: 820px) {
    .topo-grid, .duas, .quem, .fecho { grid-template-columns: 1fr; }
    .topo-grid { grid-template-areas: 'texto' 'form' 'favo'; }
    .topo-favo { margin-top: 12px; }
    .topo-favo .favo { max-width: 280px; }
    .quem img { max-width: 260px; }
  }
</style>
