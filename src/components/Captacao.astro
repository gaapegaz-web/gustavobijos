---
import Tecnoapis from '~/layouts/Tecnoapis.astro';
import LeadForm from './LeadForm.astro';
import Autoridade from './Autoridade.astro';
import Footer from './Footer.astro';
import Icons from './Icons.astro';
import TopoBlack from './TopoBlack.astro';
import ClubeConteudo from './ClubeConteudo.astro';
import { CAMPANHA } from '~/config/black';
import { fmtDataHora, fmtDiaSemana } from '~/lib/phases';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props { variante?: string; titulo?: string; sub?: string }
const {
  variante = '',
  titulo = 'A maior <em>BLACK FRIDAY</em> da história do Clube Tecnoapis.',
  sub: subProp,
} = Astro.props;

const live = new Date(CAMPANHA.live.data);
const liveJaPassou = new Date() > live;
const quando = `${fmtDiaSemana(live)}, ${fmtDataHora(live)}`;
const sub = subProp ?? 'Todos os cursos do clube numa oferta especial.';
// Foto do herói: public/img/gustavo-hero.(webp|jpg|png), vertical 4:5. Sem ela, o herói fica só texto.
// Em produção os arquivos são servidos de dist/client, então a foto só aparece depois do build (deploy.sh).
const pastaEstatica = import.meta.env.PROD ? 'dist/client' : 'public';
const fotoHero = ['webp', 'jpg', 'png'].map((ext) => `/img/gustavo-hero.${ext}`).find((f) => existsSync(join(process.cwd(), pastaEstatica, f)));
---
<Tecnoapis title={`Black Friday Tecnoapis 2026 | ${CAMPANHA.professor}`} description={sub}>
<main data-track-view="ViewContent" data-track-params='{"content_name":"Black Tecnoapis 2026"}'>
  <TopoBlack>
    <button slot="cta" type="button" class="ta-btn topo__cta cta-verde" data-abrir-form data-alvo="form:topo" data-track-click="AbriuFormulario" data-track-params='{"content_name":"topo_cta"}'>Entrar no grupo</button>
  </TopoBlack>

  <section data-secao="1-hero" class:list={['hero', { 'hero--sem-foto': !fotoHero }]}>
    <div class="hero__fundo" aria-hidden="true">
      {fotoHero ? <img src={fotoHero} alt="" width="1080" height="1920" fetchpriority="high" /> : <span class="hero__fundo-aviso">Fundo: foto do Gustavo</span>}
    </div>
    <div class="ta-container hero__body">
      <h1 class="hero__titulo" set:html={titulo} />
      <p class="hero__sub">{sub} <strong>{liveJaPassou ? 'A Black já começou.' : `Aula ao vivo: ${quando}.`}</strong></p>
      <button type="button" class="ta-btn ta-btn--lg cta-pulse cta-verde" data-abrir-form data-alvo="form:hero" data-track-click="AbriuFormulario" data-track-params='{"content_name":"hero_cta"}'>Entrar no grupo</button>
      <p class="ta-small">Entre no grupo de interessados e receba a oferta especial.</p>
    </div>
  </section>

  <section class="ta-section trava" data-secao="2-o-que-trava">
    <div class="ta-container">
      <div class="ta-intro ta-intro--center trava__topo">
        <span class="ta-pill">Na Black</span>
        <h2 class="display-l">Tudo o que entra <em>na Black</em></h2>
        <p class="ta-lead">O Clube Tecnoapis completo, do primeiro núcleo à venda do mel.</p>
      </div>
      <div class="ta-features">
        <div class="ta-feature"><span class="ta-feature__icon"><Icons name="hex" size={22} /></span><h3>Todos os cursos.</h3><p>25 cursos e 130 horas: multiplicação, rainhas, manejo, APISMONEY e mais.</p></div>
        <div class="ta-feature"><span class="ta-feature__icon"><Icons name="calendar" size={22} /></span><h3>Lives toda segunda.</h3><p>Ao vivo com o Gustavo, mais 115 lives gravadas no acervo.</p></div>
        <div class="ta-feature"><span class="ta-feature__icon"><Icons name="shield" size={22} /></span><h3>Bônus para quem chega primeiro.</h3><p>Os primeiros compradores levam bônus que não voltam depois.</p></div>
      </div>
      <div class="trava__fim">
        <p class="display-m">A oferta é revelada na aula. <span>Esteja no grupo para não perder.</span></p>
        <button type="button" class="ta-btn ta-btn--lg cta-pulse cta-verde" data-abrir-form data-alvo="form:meio" data-track-click="AbriuFormulario" data-track-params='{"content_name":"trava_cta"}'>Entrar no grupo</button>
        <p class="ta-small">{liveJaPassou ? 'Gravação da aula disponível no grupo.' : `Grátis. Aula ao vivo, ${quando}.`}</p>
      </div>
    </div>
  </section>

  <ClubeConteudo />

  <Autoridade />
</main>
<Footer />

<dialog class="modal" id="modal-inscricao" data-theme="light" aria-labelledby="modal-titulo">
  <div class="modal__box">
    <button type="button" class="modal__fechar" data-fechar-form aria-label="Fechar">&times;</button>
    <h2 id="modal-titulo" class="display-m">Entre no grupo de interessados</h2>
    <p class="ta-small">Grátis. O link do grupo chega no seu WhatsApp na hora.</p>
    <LeadForm variante={variante} titulo="" subtitulo="" cta="Entrar no grupo" comEmail={false} comConsentimento={false} />
  </div>
</dialog>

<script>
  const modal = document.getElementById('modal-inscricao') as HTMLDialogElement | null;
  if (modal) {
    const abrir = () => {
      if (typeof modal.showModal === 'function') modal.showModal(); else modal.setAttribute('open', '');
    };
    document.querySelectorAll('[data-abrir-form]').forEach((el) => el.addEventListener('click', abrir));
    modal.querySelectorAll('[data-fechar-form]').forEach((el) => el.addEventListener('click', () => modal.close()));
    modal.addEventListener('click', (ev) => { if (ev.target === modal) modal.close(); });
    if (location.hash === '#inscricao') abrir();
  }
</script>
</Tecnoapis>

<style>
  /* Herói: foto do Gustavo como fundo, texto e botão centralizados embaixo, tudo na primeira tela */
  .hero { position: relative; display: flex; align-items: flex-end; min-height: calc(100svh - 66px); overflow: hidden; background: #0a0a0a; }
  .hero__fundo { position: absolute; inset: 0; z-index: 0; }
  .hero__fundo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .hero__fundo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,.15) 0%, rgba(10,10,10,.1) 35%, rgba(10,10,10,.82) 62%, #0a0a0a 88%); }
  .hero--sem-foto .hero__fundo { background: radial-gradient(90% 55% at 50% 20%, #2a1e06 0%, #0a0a0a 75%); }
  .hero__fundo-aviso { position: absolute; top: 18%; left: 50%; transform: translateX(-50%); padding: 8px 14px; border: 1px dashed rgba(242,169,0,.5); border-radius: var(--radius-full); font: 500 13px/1 var(--font-sans); color: var(--ink-muted); white-space: nowrap; }
  .hero__body { position: relative; z-index: 1; width: 100%; display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-4); padding-bottom: var(--space-10, 40px); }
  .hero__titulo { max-width: 18ch; font-family: var(--font-display); font-size: clamp(28px, 7vw, 46px); line-height: 1.08; font-weight: 500; letter-spacing: -.01em; color: var(--ink); text-wrap: balance; }
  .hero__titulo :global(em) { font-style: normal; font-weight: 700; color: var(--accent); letter-spacing: .01em; }
  .hero__sub { max-width: 46ch; font: 400 15.5px/1.55 var(--font-sans); color: rgba(255,255,255,.78); text-wrap: pretty; }
  .hero__sub strong { color: var(--accent); font-weight: 600; }
  .hero__body .ta-btn { margin-top: var(--space-2); width: 100%; max-width: 420px; }
  .hero__body .ta-small { text-align: center; }
  @media (min-width: 640px) { .hero { min-height: calc(100svh - 70px); } }
  @media (min-width: 900px) { .hero { min-height: min(calc(100svh - 70px), 860px); } .hero__body { padding-bottom: var(--space-16); } .hero__sub { font-size: 17px; } .hero__fundo::after { background: linear-gradient(180deg, rgba(10,10,10,.1) 0%, rgba(10,10,10,.25) 40%, rgba(10,10,10,.85) 70%, #0a0a0a 95%); } }

  /* Botões verdes da captação */
  .cta-verde { background: #25d366; color: #06210f; border-color: transparent; }
  .cta-verde:hover { filter: brightness(1.06); }
  .cta-pulse.cta-verde { animation-name: cta-pulse-verde; }
  @keyframes cta-pulse-verde {
    0% { box-shadow: 0 0 0 0 rgba(37,211,102,.6); transform: scale(1); }
    50% { transform: scale(1.025); }
    70% { box-shadow: 0 0 0 16px rgba(37,211,102,0); }
    100% { box-shadow: 0 0 0 0 rgba(37,211,102,0); transform: scale(1); }
  }
  .modal :global(.ta-btn[type=submit]) { background: #25d366; color: #06210f; }

  /* O que trava: topo centralizado, cards e fechamento */
  .trava__topo { display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
  .trava__topo .ta-lead { margin-inline: auto; }
  .trava__topo em { font-style: normal; color: var(--accent-ink); }
  .ta-features { margin-top: var(--space-8); }
  .trava__fim { margin-top: var(--space-12); display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-6); }
  .trava__fim .ta-small { margin-top: calc(var(--space-3) * -1); }
  @media (min-width: 720px) { .trava__fim .display-m span { display: block; } }
  @media (min-width: 900px) { .trava__fim .ta-btn { min-width: 320px; } }

  /* Pop-up do formulário */
  .modal { width: min(440px, calc(100vw - 32px)); max-height: calc(100svh - 32px); padding: 0; border: 0; border-radius: var(--radius-lg); background: #fff; color: #111; overflow: auto; }
  .modal::backdrop { background: rgba(0,0,0,.72); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
  .modal[open] { animation: modal-in .22s ease-out; }
  .modal__box { position: relative; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-8) var(--space-6) var(--space-6); }
  .modal__box h2 { color: #111; padding-right: var(--space-8); }
  .modal__box > .ta-small { color: #555; }
  .modal__fechar { position: absolute; top: 10px; right: 10px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; color: #333; font-size: 28px; line-height: 1; cursor: pointer; }
  .modal__fechar:hover { background: #f0f0f0; }
  .modal :global(.ta-btn[type=submit]) { text-transform: uppercase; letter-spacing: .05em; font-weight: 800; }
  @keyframes modal-in { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }
</style>
