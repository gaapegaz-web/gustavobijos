---
import Tecnoapis from '~/layouts/Tecnoapis.astro';
import LeadForm from './LeadForm.astro';
import Favo from './Favo.astro';
import Autoridade from './Autoridade.astro';
import Footer from './Footer.astro';
import Icons from './Icons.astro';
import { CAMPANHA } from '~/config/black';
import { fmtDataHora, fmtDiaSemana } from '~/lib/phases';

interface Props { variante?: string; linha?: string; impacto?: string; spaced?: string; sub?: string }
const {
  variante = '',
  linha = 'De 10 para 100',
  impacto = 'Colmeias',
  spaced = 'sem comprar enxame',
  sub = 'Live gratuita com o Gustavo Bijos: o método de multiplicação, as rainhas próprias e o calendário que leva um apiário pequeno a cem colmeias.',
} = Astro.props;

const live = new Date(CAMPANHA.live.data);
const liveJaPassou = new Date() > live;
const quando = `${fmtDiaSemana(live)}, ${fmtDataHora(live)}`;
---
<Tecnoapis title={`Live: ${CAMPANHA.live.titulo} | ${CAMPANHA.professor}`} description={sub}>
<main>
  <section class="ta-section" style="padding-top:var(--space-12)">
    <div class="ta-container ta-split topo">
      <div class="topo-texto">
        <div class="ta-stack">
          <span class="ta-eyebrow">{liveJaPassou ? 'Live gravada' : `Live gratuita · ${quando}`}</span>
          <span class="ta-line ta-line--l">{linha}</span>
          <h1 class="ta-impact ta-impact--xl">{impacto}</h1>
          <span class="ta-spaced">{spaced}</span>
        </div>
        <p class="ta-lead" style="margin-top:var(--space-6)">{sub}</p>
      </div>
      <div class="topo-form"><LeadForm variante={variante} /></div>
      <div class="topo-favo"><Favo /></div>
    </div>
  </section>

  <section class="ta-section">
    <div class="ta-container ta-split">
      <div>
        <div class="ta-stack">
          <span class="ta-eyebrow">Na live</span>
          <span class="ta-line ta-line--l">O que trava o apiário em</span>
          <h2 class="ta-impact ta-impact--l">10, 15, 20</h2>
        </div>
        <p class="ta-lead" style="margin-top:var(--space-6)">Não é falta de abelha. São três decisões que quase todo apicultor toma errado nos primeiros anos. O Gustavo mostra cada uma e o que fazer no lugar.</p>
      </div>
      <ul class="ta-list ta-list--x">
        <li><Icons name="x" /><span><b>Dividir a colmeia errada.</b> Qualquer divisão sem matriz preparada vira dois enxames fracos. Como escolher, preparar e saber quando a matriz está pronta.</span></li>
        <li><Icons name="x" /><span><b>Comprar rainha.</b> A 60, 100 reais cada, multiplicar sai caro e lento. O método mais simples para produzir as suas, mesmo começando agora.</span></li>
        <li><Icons name="x" /><span><b>Dividir fora do tempo.</b> Núcleo feito longe da florada morre. O calendário de divisão, alimentação e revisão de uma temporada inteira.</span></li>
      </ul>
    </div>
  </section>

  <Autoridade />

  <section class="ta-section">
    <div class="ta-container ta-split" style="align-items:center">
      <div>
        <div class="ta-stack">
          <span class="ta-eyebrow">Vaga gratuita</span>
          <span class="ta-line ta-line--l">Entre no grupo e receba</span>
          <h2 class="ta-impact ta-impact--l">O link da live</h2>
        </div>
        <p class="ta-lead" style="margin-top:var(--space-6)">Quem está no grupo recebe o lembrete na hora, a gravação depois e, no fim da live, a condição de abertura da Black Tecnoapis antes de todo mundo.</p>
      </div>
      <LeadForm variante={variante} id="form2" titulo="Garanta sua vaga" subtitulo="" />
    </div>
  </section>
</main>
<Footer />
</Tecnoapis>

<style>
  .topo { grid-template-areas: 'texto form' 'favo form'; row-gap: var(--space-8); }
  .topo-texto { grid-area: texto; } .topo-form { grid-area: form; } .topo-favo { grid-area: favo; }
  @media (max-width: 820px) {
    .topo { grid-template-areas: 'texto' 'form' 'favo'; row-gap: var(--space-6); }
    .topo-favo .favo { max-width: 260px; }
  }
</style>
