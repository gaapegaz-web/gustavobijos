---
import Tecnoapis from '~/layouts/Tecnoapis.astro';
import LeadForm from './LeadForm.astro';
import Autoridade from './Autoridade.astro';
import Footer from './Footer.astro';
import Icons from './Icons.astro';
import TopoBlack from './TopoBlack.astro';
import ClubeConteudo from './ClubeConteudo.astro';
import { CAMPANHA } from '~/config/black';
import { fmtDataHora, fmtDiaSemana } from '~/lib/phases';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props { variante?: string; sub?: string }
const {
  variante = '',
  sub = 'Todos os cursos, as lives semanais e a comunidade do Clube Tecnoapis, na maior oferta de Black Friday da história do clube.',
} = Astro.props;

const live = new Date(CAMPANHA.live.data);
const liveJaPassou = new Date() > live;
const quando = `${fmtDiaSemana(live)}, ${fmtDataHora(live)}`;
// Foto do Gustavo ao lado do formulário (desktop) / abaixo do texto (celular): public/img/gustavo-hero.(webp|jpg|png), vertical 4:5.
// Em produção os arquivos são servidos de dist/client, então a foto só aparece depois do build (deploy.sh).
const pastaEstatica = import.meta.env.PROD ? 'dist/client' : 'public';
const fotoHero = ['webp', 'jpg', 'png'].map((ext) => `/img/gustavo-hero.${ext}`).find((f) => existsSync(join(process.cwd(), pastaEstatica, f)));

/** "Tudo o que entra na Black" (fonte: mapa de conteúdos do clube; detalhes na seção ClubeConteudo) */
const DENTRO: { icone: 'hex' | 'calendar' | 'split' | 'crown' | 'bulb' | 'chart' | 'whatsapp' | 'shield'; titulo: string; texto?: string }[] = [
  { icone: 'hex', titulo: 'Todos os cursos do Clube Tecnoapis', texto: '25 cursos e 130 horas de conteúdo, gravados no apiário.' },
  { icone: 'split', titulo: 'Multiplicação de colmeias', texto: 'Produção de Núcleos (6 métodos), Palmer Adaptado e Demaree.' },
  { icone: 'crown', titulo: 'Produção de rainhas', texto: 'Miller, Doolittle e Geleia Real, com apostila.' },
  { icone: 'bulb', titulo: 'Manejo e Leitura de Enxame', texto: 'Alvado, cria, alimento, clima e floradas.' },
  { icone: 'chart', titulo: 'APISMONEY e novas fontes de renda', texto: 'Custos, faturamento, própolis, favos e polinização.' },
  { icone: 'calendar', titulo: 'Live nova toda segunda + 115 gravadas', texto: 'Ao vivo com o Gustavo, com tira-dúvidas.' },
  { icone: 'whatsapp', titulo: 'Grupo de membros, carteirinha e descontos', texto: 'Comunidade e benefícios nas lojas parceiras.' },
  { icone: 'shield', titulo: 'Bônus para quem chega primeiro', texto: 'Os primeiros compradores levam bônus que não voltam depois.' },
];
---
<Tecnoapis title={`Black Friday Tecnoapis 2026 | ${CAMPANHA.professor}`} description={sub}>
<main data-track-view="ViewContent" data-track-params='{"content_name":"Black Tecnoapis 2026"}'>
  <TopoBlack>
    <button slot="cta" type="button" class="ta-btn topo__cta cta-verde" data-abrir-form data-alvo="form:topo" data-track-click="AbriuFormulario" data-track-params='{"content_name":"topo_cta"}'>Entrar no grupo</button>
  </TopoBlack>

  <section data-secao="1-hero" class:list={['hero', { 'hero--com-foto': fotoHero }]}>
    <div class="ta-container hero__in">
      <div class="hero__body">
        <h1 class="hero__titulo">
          <span class="hero__eyebrow">Black Friday 2026</span>
          <span class="hero__impacto">Clube <em>Tecnoapis</em></span>
          <span class="hero__spaced">com Gustavo Bijos</span>
        </h1>
        <p class="hero__sub">{sub}</p>
        <p class="hero__dica"><strong>DICA:</strong> quem chega primeiro leva&nbsp;mais.</p>
        <p class="hero__data">{liveJaPassou ? 'A Black já começou' : `Aula ao vivo: ${quando}`}</p>
        <p class="hero__convite">Na aula, o Gustavo abre a Black. Entre no grupo de interessados e receba a oferta&nbsp;especial.</p>
        <div class="hero__form" data-theme="light">
          <LeadForm variante={variante} id="form-hero" titulo="" subtitulo="" cta="Entrar no grupo de interessados" comEmail={false} comConsentimento={false} />
        </div>
      </div>
      {fotoHero && <div class="hero__foto"><img src={fotoHero} alt={CAMPANHA.professor} width="480" height="600" fetchpriority="high" /></div>}
    </div>
  </section>

  <section class="ta-section dentro" data-secao="2-dentro">
    <div class="ta-container">
      <div class="ta-intro ta-intro--center dentro__topo">
        <span class="ta-pill">Black Tecnoapis</span>
        <h2 class="display-l">Tudo o que entra <em>na Black</em></h2>
      </div>
      <ul class="dentro__lista">
        {DENTRO.map((d) => (
          <li>
            <span class="dentro__icone"><Icons name={d.icone} size={22} /></span>
            <span><b>{d.titulo}</b>{d.texto && <span>{d.texto}</span>}</span>
          </li>
        ))}
      </ul>
      <div class="dentro__fim">
        <button type="button" class="ta-btn ta-btn--lg cta-pulse cta-verde" data-abrir-form data-alvo="form:meio" data-track-click="AbriuFormulario" data-track-params='{"content_name":"dentro_cta"}'>Entrar no grupo agora</button>
        <p class="ta-small">{liveJaPassou ? 'Gravação da aula disponível no grupo.' : `Grátis. A oferta é revelada na aula, ${quando}.`}</p>
      </div>
    </div>
  </section>

  <ClubeConteudo />

  <Autoridade />
</main>
<Footer />

<dialog class="modal" id="modal-inscricao" data-theme="light" aria-labelledby="modal-titulo">
  <div class="modal__box">
    <button type="button" class="modal__fechar" data-fechar-form aria-label="Fechar">&times;</button>
    <h2 id="modal-titulo" class="display-m">Entre no grupo de interessados</h2>
    <p class="ta-small">Grátis. O link do grupo chega no seu WhatsApp na hora.</p>
    <LeadForm variante={variante} titulo="" subtitulo="" cta="Entrar no grupo" comEmail={false} comConsentimento={false} />
  </div>
</dialog>

<script>
  const modal = document.getElementById('modal-inscricao') as HTMLDialogElement | null;
  if (modal) {
    const abrir = () => {
      if (typeof modal.showModal === 'function') modal.showModal(); else modal.setAttribute('open', '');
    };
    document.querySelectorAll('[data-abrir-form]').forEach((el) => el.addEventListener('click', abrir));
    modal.querySelectorAll('[data-fechar-form]').forEach((el) => el.addEventListener('click', () => modal.close()));
    modal.addEventListener('click', (ev) => { if (ev.target === modal) modal.close(); });
    if (location.hash === '#inscricao') abrir();
  }
</script>
</Tecnoapis>

<style>
  /* Herói no formato "Black": título em camadas, dica, data, convite e formulário na primeira tela */
  .hero { background: radial-gradient(90% 60% at 50% 0%, #2a1e06 0%, #0a0a0a 70%); padding: var(--space-10, 40px) 0 var(--space-12); }
  .hero__in { display: flex; flex-direction: column; align-items: center; gap: var(--space-8); }
  .hero__body { width: 100%; max-width: 600px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-4); }
  .hero__titulo { display: flex; flex-direction: column; align-items: center; gap: 2px; text-transform: uppercase; }
  .hero__eyebrow { font: 700 clamp(16px, 4.2vw, 24px)/1.1 var(--font-sans); letter-spacing: .14em; color: var(--ink); }
  .hero__impacto { font: 600 clamp(40px, 11vw, 72px)/1 var(--font-display); letter-spacing: -.01em; color: var(--ink); }
  .hero__impacto em { font-style: normal; color: var(--accent); }
  .hero__spaced { font: 700 clamp(13px, 3.4vw, 18px)/1.2 var(--font-sans); letter-spacing: .22em; color: var(--ink); }
  .hero__sub { max-width: 46ch; font: 500 16px/1.5 var(--font-sans); color: rgba(255,255,255,.88); text-wrap: pretty; }
  .hero__dica { margin-top: calc(var(--space-2) * -1); font: 500 16px/1.4 var(--font-sans); color: rgba(255,255,255,.88); }
  .hero__dica strong { font-weight: 800; color: var(--ink); }
  .hero__data { display: inline-block; padding: 6px 18px; border-radius: 6px; background: var(--accent); color: var(--on-accent, #111); font: 700 clamp(17px, 4.5vw, 21px)/1.3 var(--font-sans); }
  .hero__convite { max-width: 44ch; font: italic 600 16px/1.45 var(--font-sans); color: var(--ink); text-wrap: balance; }
  .hero__form { width: 100%; max-width: 440px; margin-top: var(--space-2); padding: var(--space-6) var(--space-5, 20px); border-radius: var(--radius-lg); background: #fff; color: #111; text-align: left; }
  .hero__form :global(.ta-btn[type=submit]) { background: #25d366; color: #06210f; text-transform: uppercase; letter-spacing: .04em; font-weight: 800; }
  .hero__foto { width: 100%; max-width: 380px; }
  .hero__foto img { display: block; width: 100%; height: auto; border-radius: var(--radius-lg); }
  @media (min-width: 900px) {
    .hero { padding: var(--space-16) 0; }
    .hero--com-foto .hero__in { flex-direction: row; justify-content: center; align-items: center; gap: var(--space-12); }
    .hero__sub, .hero__dica { font-size: 17px; }
  }

  /* Botões verdes da captação */
  .cta-verde { background: #25d366; color: #06210f; border-color: transparent; }
  .cta-verde:hover { filter: brightness(1.06); }
  .cta-pulse.cta-verde { animation-name: cta-pulse-verde; }
  @keyframes cta-pulse-verde {
    0% { box-shadow: 0 0 0 0 rgba(37,211,102,.6); transform: scale(1); }
    50% { transform: scale(1.025); }
    70% { box-shadow: 0 0 0 16px rgba(37,211,102,0); }
    100% { box-shadow: 0 0 0 0 rgba(37,211,102,0); transform: scale(1); }
  }
  .modal :global(.ta-btn[type=submit]) { background: #25d366; color: #06210f; }

  /* Tudo o que entra na Black */
  .dentro__topo { display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
  .dentro__topo em { font-style: normal; color: var(--accent-ink); }
  .dentro__lista { list-style: none; margin: var(--space-8) auto 0; padding: 0; max-width: 760px; display: grid; gap: var(--space-3); }
  .dentro__lista li { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); border: 1px solid rgba(242,169,0,.45); border-radius: var(--radius-lg); background: linear-gradient(180deg, transparent, rgba(242,169,0,.08)); }
  .dentro__lista li > span:last-child { display: flex; flex-direction: column; gap: 2px; }
  .dentro__lista b { font: 700 15.5px/1.3 var(--font-sans); color: var(--ink); text-transform: uppercase; letter-spacing: .02em; }
  .dentro__lista li span span { font: 400 14.5px/1.4 var(--font-sans); color: var(--ink-muted); }
  .dentro__icone { flex: 0 0 44px; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 12px; background: var(--accent); color: var(--on-accent); }
  .dentro__fim { margin-top: var(--space-10, 40px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-3); }
  @media (min-width: 900px) { .dentro__lista { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 960px; } .dentro__fim .ta-btn { min-width: 320px; } }

  /* Pop-up do formulário */
  .modal { width: min(440px, calc(100vw - 32px)); max-height: calc(100svh - 32px); padding: 0; border: 0; border-radius: var(--radius-lg); background: #fff; color: #111; overflow: auto; }
  .modal::backdrop { background: rgba(0,0,0,.72); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
  .modal[open] { animation: modal-in .22s ease-out; }
  .modal__box { position: relative; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-8) var(--space-6) var(--space-6); }
  .modal__box h2 { color: #111; padding-right: var(--space-8); }
  .modal__box > .ta-small { color: #555; }
  .modal__fechar { position: absolute; top: 10px; right: 10px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; color: #333; font-size: 28px; line-height: 1; cursor: pointer; }
  .modal__fechar:hover { background: #f0f0f0; }
  .modal :global(.ta-btn[type=submit]) { text-transform: uppercase; letter-spacing: .05em; font-weight: 800; }
  @keyframes modal-in { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }
</style>
