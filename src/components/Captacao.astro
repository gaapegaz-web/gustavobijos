---
import Tecnoapis from '~/layouts/Tecnoapis.astro';
import LeadForm from './LeadForm.astro';
import Footer from './Footer.astro';
import Icons from './Icons.astro';
import TopoBlack from './TopoBlack.astro';
import BotaoGrupo from './black/BotaoGrupo.astro';
import Faixa from './black/Faixa.astro';
import Clube from './black/Clube.astro';
import Cursos from './black/Cursos.astro';
import NaBlack from './black/NaBlack.astro';
import Gustavo from './black/Gustavo.astro';
import Duvidas from './black/Duvidas.astro';
import ChamadaFinal from './black/ChamadaFinal.astro';
import '~/styles/black.css';
import { CAMPANHA } from '~/config/black';
import { fmtDataHora, fmtDiaSemana } from '~/lib/texto';
import { acharImagem } from '~/lib/imagens';

interface Props { variante?: string; titulo?: string; sub?: string }
const {
  variante = '',
  titulo = 'A maior <em>BLACK FRIDAY</em> da história do Clube Tecnoapis.',
  sub: subProp,
} = Astro.props;

const live = new Date(CAMPANHA.live.data);
const liveJaPassou = new Date() > live;
const quando = `${fmtDiaSemana(live)}, ${fmtDataHora(live)}`;
// Ex.: "sexta-feira, 6 de novembro, às 20h" (perguntas frequentes)
const quandoLongo = `${new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', weekday: 'long', day: 'numeric', month: 'long' }).format(live)}, às ${live.toLocaleTimeString('pt-BR', { hour: 'numeric', timeZone: 'America/Sao_Paulo' }).replace(/:00(:00)?$/, '')}h`;
const notaEvento = liveJaPassou ? 'Gravação do evento disponível no grupo.' : `Grátis. Evento ao vivo, ${quando}.`;
const sub = subProp ?? 'Cursos online, lives e conteúdos exclusivos para apicultores.';
// Foto do herói: public/img/gustavo-hero-black.(webp|jpg|png), a mesma da /bio (recorte de BG-HERO2.jpg), quase quadrada.
// Ela ocupa só a parte de cima do herói, para o texto ficar abaixo do rosto.
// Em produção os arquivos são servidos de dist/client, então a foto só aparece depois do build (deploy.sh).
// SEO: descrição do Google/preview (~155 caracteres) e o evento ao vivo como dado estruturado (Event)
const diaMes = live.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', timeZone: 'America/Sao_Paulo' });
const hora = live.toLocaleTimeString('pt-BR', { hour: 'numeric', timeZone: 'America/Sao_Paulo' }).replace(/:00(:00)?$/, '');
const diaHora = `${diaMes}, às ${hora}h`;
const descricaoSeo = liveJaPassou
  ? `A maior Black Friday do Clube Tecnoapis: 25 cursos de apicultura, lives semanais com Gustavo Bijos e bônus para quem chega primeiro.`
  : `Evento ao vivo e grátis com Gustavo Bijos em ${diaHora}: a maior Black Friday do Clube Tecnoapis, com 25 cursos de apicultura. Entre no grupo.`;
const urlPagina = new URL(Astro.url.pathname, CAMPANHA.dominio).toString();
const eventoLd = {
  '@type': 'Event',
  '@id': `${urlPagina}#evento`,
  // O Google não aceita promoção como evento: nome e descrição falam da live, não da oferta
  name: `${CAMPANHA.live.titulo}: evento ao vivo`,
  description: descricaoSeo,
  startDate: CAMPANHA.live.data,
  // Mesmo fuso do startDate (-03:00), em vez de UTC com Z
  endDate: new Date(live.getTime() + CAMPANHA.live.duracaoMin * 60_000 - 3 * 3_600_000).toISOString().replace(/\.\d{3}Z$/, '-03:00'),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  isAccessibleForFree: true,
  inLanguage: 'pt-BR',
  location: { '@type': 'VirtualLocation', url: urlPagina },
  image: [new URL('/img/og-black-v2.jpg', CAMPANHA.dominio).toString()],
  organizer: { '@id': `${CAMPANHA.dominio}/#clube` },
  performer: { '@id': `${CAMPANHA.dominio}/#gustavo` },
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'BRL', availability: 'https://schema.org/InStock', url: urlPagina },
};
// Sem a foto, fica a silhueta provisória (gustavo-hero-vazio.svg): o herói não muda de forma e tudo segue na primeira tela.
const fotoReal = acharImagem('gustavo-hero-black');
const fotoHero = fotoReal ?? '/img/gustavo-hero-vazio.svg';
---
<Tecnoapis title="Black Friday Clube Tecnoapis 2026 | Gustavo Bijos" ogTitle="A maior Black Friday da história do Clube Tecnoapis" description={descricaoSeo} ogImage="/img/og-black-v2.jpg" ogImageAlt="Black Friday Tecnoapis: evento ao vivo com Gustavo Bijos" jsonLd={liveJaPassou ? [] : [eventoLd]}>
<main class="bf">
  <TopoBlack>
    <nav slot="nav" class="topo__nav" aria-label="Seções da página"><a href="#clube">O Clube</a><a href="#conteudo">Conteúdo</a><a href="#gustavo">Gustavo</a><a href="#duvidas">Dúvidas</a></nav>
    <BotaoGrupo slot="cta" alvo="form:topo" nome="topo_cta" pulso={false} icone={16} class="topo__cta" />
  </TopoBlack>

  <section data-secao="1-hero" class:list={['hero', { 'hero--sem-foto': !fotoReal }]}>
    <div class="hero__fundo" aria-hidden="true">
      <img src={fotoHero} alt="" width="760" height="720" fetchpriority="high" />
    </div>
    <!-- Favos nos cantos, como na arte da campanha -->
    <svg class="hero__favo hero__favo--topo" aria-hidden="true" viewBox="0 0 108 110" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M28 2l26 15v30l-26 15-26-15V17zM80 2l26 15v30l-26 15-26-15V17zM54 47l26 15v30l-26 15-26-15V62zM106 47l26 15v30l-26 15-26-15V62z"/></svg>
    <svg class="hero__favo hero__favo--base" aria-hidden="true" viewBox="0 0 108 110" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M28 2l26 15v30l-26 15-26-15V17zM80 2l26 15v30l-26 15-26-15V17zM54 47l26 15v30l-26 15-26-15V62zM106 47l26 15v30l-26 15-26-15V62z"/></svg>
    <div class="ta-container hero__body">
      <div class="hero__selo">
        <span class="hero__tag">{liveJaPassou ? 'Já começou' : 'Vem aí'}</span>
        <span class="hero__linha" aria-hidden="true"></span>
        <Icons name="abelha" size={22} />
      </div>
      <h1 class="hero__titulo" set:html={titulo} />
      <p class="hero__sub">{sub}</p>
      {!liveJaPassou && (
        <p class="hero__data">
          <Icons name="calendar" size={30} />
          <span class="hero__data-div" aria-hidden="true"></span>
          <strong>{diaMes}</strong>
          <span class="hero__data-ponto" aria-hidden="true">·</span>
          <span class="hero__data-hora">{fmtDiaSemana(live)}, às {hora}h</span>
        </p>
      )}
      <div class="hero__acoes">
        <BotaoGrupo alvo="form:hero" nome="hero_cta" />
        <a class="ta-btn ta-btn--lg bf-btn-fantasma hero__clube" href="#clube">Conhecer o Clube</a>
      </div>
      <p class="hero__nota">Online e gratuito. O link chega no seu WhatsApp.</p>
    </div>
  </section>

  <Faixa />
  <Clube />
  <Cursos />
  <NaBlack nota={notaEvento} />
  <Gustavo />
  <Duvidas quandoLongo={quandoLongo} liveJaPassou={liveJaPassou} />
  <ChamadaFinal selo={liveJaPassou ? 'Black Friday Clube Tecnoapis' : `${diaMes} · às ${hora}h`} nota={liveJaPassou ? 'A gravação do evento está no grupo.' : 'Grátis. O link chega no seu WhatsApp.'} />
</main>
<Footer />

<dialog class="modal" id="modal-inscricao" data-theme="light" aria-labelledby="modal-titulo">
  <div class="modal__box">
    <button type="button" class="modal__fechar" data-fechar-form aria-label="Fechar">&times;</button>
    <h2 id="modal-titulo" class="display-m">Entre no grupo de interessados</h2>
    <p class="ta-small">Grátis. O link do grupo chega no seu WhatsApp na hora.</p>
    <LeadForm variante={variante} titulo="" subtitulo="" cta="Entrar no grupo" comEmail={false} comConsentimento={false} />
  </div>
</dialog>

<script>
  const modal = document.getElementById('modal-inscricao') as HTMLDialogElement | null;
  if (modal) {
    const abrir = () => {
      if (typeof modal.showModal === 'function') modal.showModal(); else modal.setAttribute('open', '');
    };
    document.querySelectorAll('[data-abrir-form]').forEach((el) => el.addEventListener('click', abrir));
    modal.querySelectorAll('[data-fechar-form]').forEach((el) => el.addEventListener('click', () => modal.close()));
    modal.addEventListener('click', (ev) => { if (ev.target === modal) modal.close(); });
    if (location.hash === '#inscricao') abrir();
  }
</script>
</Tecnoapis>

<style>
  /* Herói no molde da arte da campanha: foto no alto à direita, texto à esquerda, faixa de data e favos nos cantos. Pensado primeiro para o celular. */
  .hero { position: relative; display: flex; align-items: flex-end; min-height: calc(100svh - 66px); overflow: hidden; background: var(--bf-ink); isolation: isolate; }
  .hero__fundo { position: absolute; top: 0; right: 0; width: 100%; height: 66%; z-index: -1; }
  .hero__fundo img { width: 100%; height: 100%; object-fit: cover; object-position: 62% top; display: block; }
  /* Escurece a esquerda (onde fica o texto) e funde a base no preto */
  .hero__fundo::after { content: ''; position: absolute; inset: 0; background:
    linear-gradient(90deg, rgba(16,16,14,.7) 0%, rgba(16,16,14,.15) 45%, rgba(16,16,14,0) 70%),
    linear-gradient(180deg, rgba(16,16,14,0) 35%, rgba(16,16,14,.7) 72%, var(--bf-ink) 100%); }
  .hero__favo { position: absolute; z-index: -1; color: var(--accent); pointer-events: none; }
  .hero__favo--topo { top: -30px; right: -46px; width: 120px; opacity: .9; }
  .hero__favo--base { bottom: -50px; left: -52px; width: 130px; opacity: .4; transform: rotate(180deg); }
  .hero__body { position: relative; width: 100%; display: flex; flex-direction: column; align-items: flex-start; text-align: left; gap: var(--space-4); padding-bottom: var(--space-8, 32px); }
  .hero__selo { display: flex; align-items: center; gap: 10px; color: var(--accent); }
  .hero__tag { display: inline-flex; align-items: center; height: 30px; padding: 0 18px; border: 1.5px solid var(--accent); border-radius: var(--radius-full); color: var(--accent); font: 700 12px/1 var(--font-sans); letter-spacing: .32em; text-transform: uppercase; white-space: nowrap; background: rgba(16,16,14,.35); }
  .hero__linha { width: 44px; height: 1.5px; background: var(--accent); }
  .hero__titulo { max-width: 13ch; font-family: var(--font-display); font-size: clamp(36px, 10.4vw, 58px); line-height: 1.02; font-weight: 700; letter-spacing: -.01em; color: #fff; text-shadow: 0 2px 18px rgba(0,0,0,.45); }
  .hero__titulo :global(em) { font-style: normal; font-weight: 700; color: var(--accent); white-space: nowrap; }
  .hero__sub { max-width: 32ch; font: 400 16px/1.45 var(--font-sans); color: rgba(255,255,255,.86); }
  .hero__sub strong { color: var(--accent); font-weight: 600; }
  /* Faixa da data: linhas douradas em cima e embaixo, como na arte */
  .hero__data { display: flex; align-items: center; gap: 14px; width: 100%; max-width: 420px; padding: 12px 4px; margin-top: var(--space-1, 4px); color: var(--accent); border-block: 1px solid transparent; border-image: linear-gradient(90deg, var(--accent), rgba(242,169,0,.25)) 1; }
  .hero__data-div { width: 1.5px; align-self: stretch; background: var(--accent); opacity: .7; }
  .hero__data strong { font: 700 32px/1 var(--font-sans); letter-spacing: -.02em; color: var(--accent); }
  .hero__data-ponto { font: 700 22px/1 var(--font-sans); }
  .hero__data-hora { font: 700 17px/1 var(--font-sans); letter-spacing: .06em; text-transform: uppercase; color: #fff; }
  /* Celular: só o botão verde, largo. Computador: botão verde + "Conhecer o Clube" lado a lado */
  .hero__acoes { display: flex; gap: var(--space-3); width: 100%; max-width: 420px; margin-top: var(--space-2); }
  .hero__acoes :global(.ta-btn) { width: 100%; }
  .hero__clube { display: none; }
  .hero__nota { margin-top: calc(var(--space-2) * -1); width: 100%; max-width: 420px; text-align: center; font: 400 13px/1.4 var(--font-sans); color: rgba(255,255,255,.6); }
  /* Celular baixo (ex.: SE): enxuga para caber tudo na primeira tela */
  @media (max-height: 700px) and (max-width: 639px) { .hero__body { gap: var(--space-3); padding-bottom: var(--space-6); } .hero__titulo { font-size: clamp(32px, 9vw, 40px); } .hero__sub { font-size: 15px; } .hero__data { padding-block: 8px; } .hero__data strong { font-size: 26px; } .hero__fundo { height: 58%; } }
  @media (min-width: 640px) { .hero { min-height: calc(100svh - 70px); } }
  /* Telas largas: foto ocupa a metade direita, texto na esquerda */
  @media (min-width: 900px) {
    .hero { min-height: min(calc(100svh - 70px), 860px); align-items: center; }
    .hero__fundo { width: 58%; height: 100%; -webkit-mask-image: linear-gradient(90deg, transparent, #000 30%); mask-image: linear-gradient(90deg, transparent, #000 30%); }
    .hero__fundo img { object-position: center top; }
    .hero__fundo::after { background: linear-gradient(180deg, rgba(16,16,14,0) 60%, var(--bf-ink) 100%); }
    .hero__body { padding-block: var(--space-16); }
    .hero__titulo { font-size: clamp(48px, 5vw, 68px); }
    .hero__sub { font-size: 18px; }
    .hero__favo--topo { width: 160px; right: -60px; }
    .hero__favo--base { width: 180px; }
    .hero__acoes { max-width: none; }
    .hero__acoes :global(.cta-verde) { width: auto; min-width: 300px; }
    .hero__clube { display: inline-flex; width: auto !important; }
    .hero__nota { max-width: none; text-align: left; margin-top: 0; }
  }

  /* Links de âncora do topo: só no computador */
  .topo__nav { display: none; }
  @media (min-width: 1000px) {
    .topo__nav { display: flex; gap: 28px; margin-left: auto; margin-right: var(--space-6); }
    .topo__nav a { font: 600 13.5px/1 var(--font-sans); color: #dad5c9; text-decoration: none; transition: color .15s; }
    .topo__nav a:hover { color: var(--accent); }
  }

  .modal :global(.ta-btn[type=submit]) { background: #25d366; color: #06210f; }

  /* Pop-up do formulário */
  .modal { width: min(440px, calc(100vw - 32px)); max-height: calc(100svh - 32px); padding: 0; border: 0; border-radius: var(--radius-lg); background: #fff; color: #111; overflow: auto; }
  .modal::backdrop { background: rgba(0,0,0,.72); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
  .modal[open] { animation: modal-in .22s ease-out; }
  .modal__box { position: relative; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-8) var(--space-6) var(--space-6); }
  .modal__box h2 { color: #111; padding-right: var(--space-8); }
  .modal__box > .ta-small { color: #555; }
  .modal__fechar { position: absolute; top: 10px; right: 10px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; color: #333; font-size: 28px; line-height: 1; cursor: pointer; }
  .modal__fechar:hover { background: #f0f0f0; }
  .modal :global(.ta-btn[type=submit]) { text-transform: uppercase; letter-spacing: .05em; font-weight: 800; }
  @keyframes modal-in { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }
</style>
