---
/** Barra fixa da Black: logo à esquerda, informação curta ao lado, botão à direita (slot "cta"). Com `centro`, só a logo, centralizada. */
interface Props { centro?: boolean }
const { centro = false } = Astro.props;
---
<header class:list={['topo', { 'topo--centro': centro }]}>
  <div class="ta-container topo__in">
    <div class="topo__info">
      <img class="topo__logo" src="/img/black-friday-logo.webp" alt="Black Friday Tecnoapis" width="353" height="160" />
      <slot />
    </div>
    <slot name="cta" />
  </div>
</header>
