---
import { ENV } from '~/lib/env';
import { CAMPANHA } from '~/config/black';
interface Props { title: string; description?: string; leadEventId?: string; noindex?: boolean; ogImage?: string }
const { title, description = CAMPANHA.live.subtitulo, leadEventId, noindex = false, ogImage = '/img/og.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, CAMPANHA.dominio).toString();
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, CAMPANHA.dominio).toString()} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#0b0b0d" />
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script is:inline define:vars={{ pixelId: ENV.META_PIXEL_ID, leadEventId }}>
    window.__TA = { pixelId, leadEventId };
  </script>
  <script is:inline src="/js/tracking.js" defer></script>
  {ENV.META_PIXEL_ID && <noscript><img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${ENV.META_PIXEL_ID}&ev=PageView&noscript=1`} /></noscript>}
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root {
    --bg: #0b0b0d; --bg2: #141418; --bg3: #1c1c22; --line: #2a2a33;
    --fg: #f4f1ec; --muted: #a7a3a0; --dim: #6f6b68;
    --brand: #f26b1d; --brand2: #ff8a3d; --brand-dark: #b94e12;
    --ok: #3ccb7f; --warn: #ffd166; --danger: #ff5a5a;
    --radius: 14px; --max: 1120px;
    --font: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --display: 'Bebas Neue', 'Inter', Impact, sans-serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font); line-height: 1.55; font-size: 17px; }
  img { max-width: 100%; display: block; }
  a { color: var(--brand2); }
  h1, h2, h3 { line-height: 1.1; margin: 0 0 .5em; letter-spacing: -.01em; }
  h1 { font-size: clamp(2.1rem, 5.5vw, 3.6rem); font-weight: 800; }
  h2 { font-size: clamp(1.7rem, 4vw, 2.5rem); font-weight: 800; }
  h3 { font-size: 1.25rem; font-weight: 700; }
  p { margin: 0 0 1em; }
  .display { font-family: var(--display); font-weight: 400; letter-spacing: .02em; text-transform: uppercase; }
  .brand { color: var(--brand); }
  .muted { color: var(--muted); }
  .wrap { max-width: var(--max); margin: 0 auto; padding: 0 20px; }
  .section { padding: clamp(48px, 8vw, 96px) 0; }
  .section + .section { border-top: 1px solid var(--line); }
  .eyebrow { display: inline-block; font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--brand); margin-bottom: 14px; }
  .lead { font-size: 1.2rem; color: var(--muted); max-width: 60ch; }
  .center { text-align: center; }
  .center .lead { margin-inline: auto; }
  .grid { display: grid; gap: 20px; }
  .grid-2 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .grid-3 { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .card { background: var(--bg2); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .card.hot { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand), 0 20px 60px -30px var(--brand); }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 18px 32px; border-radius: 999px; font-weight: 800; font-size: 1.05rem; text-decoration: none; border: 0; cursor: pointer; transition: transform .12s, box-shadow .12s, background .12s; }
  .btn-primary { background: var(--brand); color: #111; box-shadow: 0 10px 30px -10px var(--brand); }
  .btn-primary:hover { background: var(--brand2); transform: translateY(-1px); }
  .btn-ghost { background: transparent; color: var(--fg); border: 1px solid var(--line); }
  .btn-block { width: 100%; }
  .btn-lg { padding: 22px 40px; font-size: 1.15rem; }
  .pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--bg3); border: 1px solid var(--line); font-size: .85rem; font-weight: 600; }
  .pill.brand { background: rgba(242,107,29,.12); border-color: rgba(242,107,29,.4); color: var(--brand2); }
  .check { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .check li { padding-left: 32px; position: relative; }
  .check li::before { content: ''; position: absolute; left: 0; top: 4px; width: 20px; height: 20px; border-radius: 50%; background: rgba(242,107,29,.15); border: 1px solid var(--brand); }
  .check li::after { content: ''; position: absolute; left: 7px; top: 8px; width: 5px; height: 9px; border: solid var(--brand); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .check.x li::before { background: rgba(255,90,90,.1); border-color: var(--danger); }
  .check.x li::after { border: 0; width: 10px; height: 2px; background: var(--danger); top: 13px; left: 5px; transform: none; }
  .form { display: grid; gap: 14px; }
  .field label { display: block; font-size: .85rem; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
  .field input[type=text], .field input[type=tel], .field input[type=email] { width: 100%; padding: 16px 18px; font: inherit; font-size: 1.05rem; color: var(--fg); background: var(--bg3); border: 1px solid var(--line); border-radius: 12px; outline: none; }
  .field input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(242,107,29,.2); }
  .field.err input { border-color: var(--danger); }
  .field .msg { font-size: .85rem; color: var(--danger); margin-top: 6px; min-height: 1em; }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: .8rem; color: var(--muted); }
  .consent input { margin-top: 4px; accent-color: var(--brand); }
  .strike { text-decoration: line-through; color: var(--dim); }
  .countdown { display: inline-flex; gap: 10px; }
  .countdown > div { min-width: 64px; padding: 10px 8px; background: var(--bg3); border: 1px solid var(--line); border-radius: 10px; text-align: center; }
  .countdown b { display: block; font-family: var(--display); font-size: 2rem; line-height: 1; color: var(--fg); }
  .countdown small { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .stat b { display: block; font-family: var(--display); font-size: 2.8rem; line-height: 1; color: var(--brand); }
  .stat span { font-size: .9rem; color: var(--muted); }
  details { border: 1px solid var(--line); border-radius: 12px; background: var(--bg2); padding: 0 20px; }
  details + details { margin-top: 10px; }
  summary { cursor: pointer; padding: 18px 0; font-weight: 700; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  summary::after { content: '+'; color: var(--brand); font-size: 1.4rem; line-height: 1; }
  details[open] summary::after { content: '–'; }
  details p { padding-bottom: 18px; color: var(--muted); }
  .sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); background: rgba(11,11,13,.92); backdrop-filter: blur(10px); border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: center; gap: 16px; }
  .sticky-cta .btn { padding: 14px 24px; }
  @media (max-width: 640px) { body { font-size: 16px; } .sticky-cta { flex-direction: column; gap: 8px; } .sticky-cta .btn { width: 100%; } .countdown > div { min-width: 56px; } .countdown b { font-size: 1.6rem; } }
  .fade { animation: fade .5s ease both; } @keyframes fade { from { opacity: 0; transform: translateY(8px);} to { opacity: 1; transform: none; } }
</style>
