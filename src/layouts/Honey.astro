---
import { ENV } from '~/lib/env';
import { CAMPANHA } from '~/config/black';
interface Props { title: string; description?: string; leadEventId?: string; noindex?: boolean; ogImage?: string }
const { title, description = CAMPANHA.live.subtitulo, leadEventId, noindex = false, ogImage = '/img/og.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, CAMPANHA.dominio).toString();
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, CAMPANHA.dominio).toString()} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#E9A61C" />
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline define:vars={{ pixelId: ENV.META_PIXEL_ID, leadEventId }}>window.__TA = { pixelId, leadEventId };</script>
  <script is:inline src="/js/tracking.js" defer></script>
  {ENV.META_PIXEL_ID && <noscript><img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${ENV.META_PIXEL_ID}&ev=PageView&noscript=1`} /></noscript>}
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root {
    --mel: #E9A61C; --mel-escuro: #C67F0E; --mel-claro: #F3BE4A;
    --cera: #FFF4D6; --cera-2: #F4E3B0;
    --propolis: #2E1A0B; --madeira: #6B4420; --fumaca: #8A7A62;
    --branco: #FFFDF7; --erro: #B3261E;
    --texto: 'Barlow', system-ui, sans-serif;
    --titulo: 'Barlow Condensed', 'Barlow', system-ui, sans-serif;
    --max: 1080px;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--cera); color: var(--propolis); font-family: var(--texto); font-size: 17px; line-height: 1.5; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  h1, h2, h3 { font-family: var(--titulo); font-weight: 800; line-height: .95; letter-spacing: -.005em; margin: 0 0 .4em; }
  h1 { font-size: clamp(2.9rem, 8.5vw, 5.4rem); }
  h2 { font-size: clamp(2.2rem, 5.5vw, 3.4rem); }
  h3 { font-size: 1.5rem; line-height: 1.1; }
  p { margin: 0 0 1em; max-width: 58ch; }
  .wrap { max-width: var(--max); margin: 0 auto; padding-inline: clamp(20px, 4vw, 40px); }
  .faixa { padding-block: clamp(48px, 8vw, 104px); }
  .faixa-mel { background: var(--mel); }
  .faixa-propolis { background: var(--propolis); color: var(--cera); }
  .faixa-propolis p { color: var(--cera-2); }
  .grande { font-size: clamp(1.1rem, 2.2vw, 1.3rem); }
  .apoio { color: var(--fumaca); }
  .faixa-mel .apoio { color: var(--madeira); }
  .botao { display: inline-flex; align-items: center; justify-content: center; min-height: 58px; padding: 14px 28px; border-radius: 8px; border: 0; cursor: pointer; font: 600 1.05rem/1.2 var(--texto); text-decoration: none; transition: background .15s, transform .15s; }
  .botao:active { transform: translateY(1px); }
  .botao-propolis { background: var(--propolis); color: var(--cera); }
  .botao-propolis:hover { background: var(--madeira); }
  .botao-mel { background: var(--mel); color: var(--propolis); }
  .botao-mel:hover { background: var(--mel-claro); }
  .botao:focus-visible, input:focus-visible { outline: 3px solid var(--propolis); outline-offset: 3px; }
  .faixa-propolis .botao:focus-visible, .faixa-propolis input:focus-visible { outline-color: var(--mel); }
  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .lista li { position: relative; padding-left: 34px; }
  .lista li::before { content: ''; position: absolute; left: 0; top: .2em; width: 18px; height: 20px; background: var(--mel-escuro); clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); }
  .faixa-propolis .lista li::before { background: var(--mel); }
  .formulario { background: var(--branco); color: var(--propolis); border-radius: 12px; padding: clamp(22px, 3.5vw, 32px); box-shadow: 0 2px 0 var(--mel-escuro), 0 24px 48px -28px rgba(46,26,11,.5); }
  .formulario h3 { margin-bottom: 4px; }
  .campo { display: block; margin-top: 14px; }
  .campo span { display: block; font-size: .9rem; font-weight: 600; margin-bottom: 6px; }
  .campo input { width: 100%; font: 500 1.1rem var(--texto); padding: 14px 16px; border: 2px solid var(--cera-2); border-radius: 8px; background: #fff; color: var(--propolis); }
  .campo input:focus { border-color: var(--mel-escuro); outline: none; }
  .campo.erro input { border-color: var(--erro); }
  .campo .msg { color: var(--erro); font-size: .9rem; min-height: 1.2em; margin-top: 4px; }
  .consentimento { display: flex; gap: 10px; align-items: flex-start; font-size: .85rem; color: var(--fumaca); margin-top: 14px; }
  .consentimento input { margin-top: 3px; accent-color: var(--mel-escuro); width: 18px; height: 18px; flex: none; }
  .formulario .botao { width: 100%; margin-top: 18px; font-size: 1.15rem; min-height: 64px; }
  .nota { font-size: .85rem; color: var(--fumaca); margin: 12px 0 0; }
  .contagem { display: inline-flex; gap: 8px; font-family: var(--titulo); font-weight: 700; }
  .contagem > div { text-align: center; min-width: 54px; }
  .contagem b { display: block; font-size: 2.2rem; line-height: 1; font-weight: 800; }
  .contagem small { font-size: .8rem; font-weight: 600; text-transform: lowercase; color: var(--madeira); }
  .faixa-propolis .contagem small { color: var(--mel); }
  @media (max-width: 640px) { body { font-size: 16px; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0s !important; transition-duration: 0s !important; } }
</style>
