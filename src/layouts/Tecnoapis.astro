---
import '~/styles/fontes.css';
import '~/styles/tokens.css';
import '~/styles/tecnoapis.css';
import '~/styles/site.css';
import { ENV } from '~/lib/env';
import { BIO, MARCAS, PERFIS_CLUBE, PERFIS_GUSTAVO, SITE, TEMAS, visiveis } from '~/config/site';
import { acharImagem } from '~/lib/imagens';
/**
 * SEO e preview de link. og:image é o que aparece no WhatsApp, Facebook, Instagram e LinkedIn:
 * JPG 1200x630 com menos de 300 KB (o WhatsApp ignora imagem maior). A padrão é gerada por
 * /srv/tecnoapis/tools/og-gustavo.mjs (campanhas passam a própria, ex.: og.mjs da Black).
 * ogTitle: título do card de preview (pode ser mais chamativo que o <title> do Google).
 * jsonLd: dados estruturados extras da página (Organization, Person e WebSite já vêm aqui, de site.ts).
 * pageType: 'ProfilePage' na home (a página É sobre o Gustavo).
 * noindex: fora do Google, mas os links continuam valendo (noindex,follow). nofollow: só onde nem os links importam (/obrigado).
 */
interface Props {
  title: string; description?: string; ogTitle?: string; leadEventId?: string; noindex?: boolean; nofollow?: boolean;
  ogImage?: string; ogImageAlt?: string; jsonLd?: Record<string, unknown>[]; am?: Record<string, string>;
  pageType?: 'WebPage' | 'ProfilePage';
  /** Imagem de fundo (CSS) que o navegador só descobriria depois do CSS: pré-carrega. */
  preload?: string;
  /** true = não carrega o rastreamento (Pixel nem CAPI): prévias e testes, para não mandar evento real à Meta. */
  semPixel?: boolean;
}
const {
  title, description = BIO.resumo, pageType = 'WebPage', ogTitle = title, leadEventId, noindex = false, nofollow = false,
  semPixel = false, preload, ogImage = '/img/og-gustavo.jpg', ogImageAlt = 'Gustavo Bijos, apicultor e criador do Clube Tecnoapis', jsonLd = [], am,
} = Astro.props;
// Canonical sempre sem barra final (o middleware redireciona /x/ para /x). Na 404 não faz sentido declarar URL.
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', SITE.dominio).toString();
const ehErro = Astro.response.status >= 400;
const robots = noindex ? (nofollow ? 'noindex,nofollow' : 'noindex,follow') : 'index,follow,max-image-preview:large,max-snippet:-1';
const ogImageTipo = /\.png$/i.test(ogImage) ? 'image/png' : /\.webp$/i.test(ogImage) ? 'image/webp' : 'image/jpeg';
const fotoGustavo = acharImagem('gustavo');
const ogImageUrl = new URL(ogImage, SITE.dominio).toString();
const site = SITE.dominio + '/';
// Entidades fixas do site (vêm de site.ts, nunca de campanha). Fatos não confirmados ficam fora.
const sameAsGustavo = PERFIS_GUSTAVO;
// Empresas do Gustavo (APIS+, NB...): cada uma vira Organization com ele como fundador.
const empresas = visiveis(MARCAS).filter((m) => m.empresa);
const grafo = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'EducationalOrganization'], '@id': `${site}#clube`, name: SITE.clube, url: new URL(SITE.clubeUrl, SITE.dominio).toString(),
      description: `Escola online de apicultura criada por ${SITE.professor}: multiplicação de colmeias, produção de rainhas, manejo, gestão e lives semanais.`,
      logo: new URL('/img/icon-512.png', SITE.dominio).toString(), founder: { '@id': `${site}#gustavo` },
      areaServed: { '@type': 'Country', name: 'Brasil' }, knowsAbout: TEMAS,
      ...(PERFIS_CLUBE.length ? { sameAs: PERFIS_CLUBE } : {}),
    },
    {
      '@type': 'Person', '@id': `${site}#gustavo`, name: SITE.professor, alternateName: SITE.apelido, url: site,
      jobTitle: `${BIO.formacao} e apicultor`, description: `${BIO.formacao} e apicultor. ${BIO.resumo} ${BIO.anos} anos de apicultura.`,
      ...(fotoGustavo ? { image: new URL(fotoGustavo, SITE.dominio).toString() } : {}),
      hasOccupation: [{ '@type': 'Occupation', name: 'Apicultor' }, { '@type': 'Occupation', name: BIO.formacao }], knowsLanguage: 'pt-BR',
      worksFor: [{ '@id': `${site}#clube` }, ...empresas.map((m) => ({ '@id': `${site}#${m.id}` }))],
      homeLocation: { '@type': 'City', name: BIO.cidade.nome, containedInPlace: { '@type': 'State', name: BIO.cidade.estado, containedInPlace: { '@type': 'Country', name: 'Brasil' } } },
      ...(BIO.crmv ? { hasCredential: { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Registro profissional', name: BIO.crmv, recognizedBy: { '@type': 'Organization', name: `Conselho Regional de Medicina Veterinária (${BIO.cidade.uf})` } } } : {}),
      knowsAbout: TEMAS,
      ...(sameAsGustavo.length ? { sameAs: sameAsGustavo } : {}),
    },
    ...empresas.map((m) => ({ '@type': 'Organization', '@id': `${site}#${m.id}`, name: m.nome, description: m.descricao, founder: { '@id': `${site}#gustavo` }, ...(m.url && m.externo ? { url: m.url } : {}) })),
    { '@type': 'WebSite', '@id': `${site}#site`, url: site, name: SITE.apelido, alternateName: `${SITE.professor} | ${SITE.clube}`, inLanguage: 'pt-BR', publisher: { '@id': `${site}#gustavo` } },
    { '@type': pageType, '@id': `${canonical}#pagina`, url: canonical, name: title, description, inLanguage: 'pt-BR', isPartOf: { '@id': `${site}#site` }, primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl, width: 1200, height: 630 }, ...(pageType === 'ProfilePage' ? { mainEntity: { '@id': `${site}#gustavo` } } : {}) },
    ...jsonLd,
  ],
};
---
<!doctype html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!ehErro && <link rel="canonical" href={canonical} />}
  <meta name="robots" content={robots} />
  <meta name="author" content={SITE.professor} />

  <meta property="og:type" content={pageType === 'ProfilePage' ? 'profile' : 'website'} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content={SITE.apelido} />
  {!ehErro && <meta property="og:url" content={canonical} />}
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:secure_url" content={ogImageUrl} />
  <meta property="og:image:type" content={ogImageTipo} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <meta name="theme-color" content="#0a0a0a" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
  <link rel="icon" href="/img/icon-48.png?v=2" type="image/png" sizes="48x48" />
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png?v=2" />
  <link rel="alternate" type="text/markdown" href="/llms.txt" title="Resumo do site para IAs" />
  {preload && <link rel="preload" as="image" href={preload} />}
  {/* Fontes próprias (src/styles/fontes.css): pré-carrega as duas para o texto aparecer antes */}
  <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-v20-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-v38-latin.woff2" crossorigin />
  {!semPixel && <script is:inline define:vars={{ pixelId: ENV.META_PIXEL_ID, leadEventId, am }}>window.__TA = { pixelId, leadEventId, am };</script>}
  {!semPixel && <script is:inline src="/js/ta-v4.js" defer></script>}
</head>
<body class="ta-root">
  {/* JSON-LD e noscript ficam no body: no head atrasavam a descoberta do CSS e das fontes, e <img> nem é válido lá */}
  {!noindex && <script type="application/ld+json" set:html={JSON.stringify(grafo)} />}
  {ENV.META_PIXEL_ID && !semPixel && <noscript><img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${ENV.META_PIXEL_ID}&ev=PageView&noscript=1`} /></noscript>}
  <slot />
</body>
</html>
