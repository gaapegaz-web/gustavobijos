[Unit]
Description=Tecnoapis Black (Astro SSR)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/tecnoapis/app
EnvironmentFile=/srv/tecnoapis/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node ./dist/server/entry.mjs
Restart=always
RestartSec=3
User=root
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
