# /etc/caddy/Caddyfile
# http://www -> https raiz em um salto só (sem passar por https://www)
http://www.gustavobijos.com.br {
    redir https://gustavobijos.com.br{uri} permanent
}

gustavobijos.com.br, www.gustavobijos.com.br {
    # www -> raiz
    @www host www.gustavobijos.com.br
    redir @www https://gustavobijos.com.br{uri} permanent

    encode zstd gzip

    # /_astro/* tem hash no nome e /fonts/* tem versão no nome: podem ficar 1 ano no cache
    # ">" = aplica depois da resposta do Node (senão o cabeçalho sai duplicado)
    @imutavel path /_astro/* /fonts/*
    header @imutavel >Cache-Control "public, max-age=31536000, immutable"

    # demais estáticos: 7 dias (imagens trocam de nome com ?v=)
    @static path /js/* /img/* /favicon.ico /robots.txt
    header @static >Cache-Control "public, max-age=604800"

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }

    reverse_proxy 127.0.0.1:4321 {
        header_up X-Real-IP {remote_host}
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 5
        }
    }
}
