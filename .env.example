# Copie para /srv/tecnoapis/.env e preencha
HOST=127.0.0.1
PORT=4321
DB_PATH=/srv/tecnoapis/data/app.db

# Meta
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=        # só durante testes no Gerenciador de Eventos

# Hubla
HUBLA_WEBHOOK_TOKEN=         # segredo que você configura no webhook da Hubla
HUBLA_CHECKOUT_URL=https://pay.hubla.com.br/XXXX

# WhatsApp
WHATSAPP_GRUPO_URL=https://chat.whatsapp.com/XXXX
WHATSAPP_SUPORTE_URL=https://wa.me/55XXXXXXXXXXX   # atendimento

# Admin (/admin)
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha


# Raiz do domínio redireciona para a campanha enquanto ela durar. Vazio = mostra a home do Gustavo.
REDIRECT_RAIZ=

# Checkout da Assinatura Anual Tecnoapis (página /tecnoapis, R$ 697). Vazio = botão vai para o WhatsApp.
HUBLA_CHECKOUT_CLUBE_URL=
